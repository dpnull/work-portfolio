---
import "../styles/global.css";
import DevBar from "../components/DevBar.astro";

/**
 * Site-wide shell: meta, fonts, analytics slot.
 * Real title/description/OG copy lands in block 5 from the Notion Site row.
 */

// Pre-launch: keep the *.pages.dev URL out of search results.
// Flip to false in block 6, once work.dpy2k.com is the live hostname.
const NOINDEX = true;

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
// build.format "file" emits /index.html, which must not leak into the canonical.
const path = Astro.url.pathname.replace(/index\.html$/, "").replace(/\.html$/, "");
const canonical = new URL(path, Astro.site);
---

<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {NOINDEX && <meta name="robots" content="noindex, nofollow" />}

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary_large_image" />
    {/* og:image — block 5 */}

    <link
      rel="preload"
      href="/fonts/instrument-sans-400-700.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    <meta name="theme-color" content="#ebe6f1" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    {/* Cloudflare Web Analytics — block 5 */}
  </head>

  <body class="bg-ground text-ink antialiased">
    <slot />
    {/* Dev-only control rail. Renders on `npm run dev`, absent from the build. */}
    <DevBar />
  </body>
</html>
