---
import Base from "../layouts/Base.astro";
import Footer from "../components/Footer.astro";
import SocialRail from "../components/SocialRail.astro";
import CreativeTechGraphic from "../components/CreativeTechGraphic.astro";
import AudienceProof from "../components/AudienceProof.astro";
import Hero from "../components/Hero.astro";
---
<Base title="Creative Tech & Content Systems — Dom Przewozny" description="Audience funnels, creative production and web development. The work behind my content, with a Computer Science background." photoTransition>
  <main class="tech-page">
    <section class="introduction" aria-labelledby="tech-heading">
      <figure class="portrait"><img data-tech-photo src="/work-with-me.webp" alt="Dom overlooking the city at sunset" width="1000" height="1000" fetchpriority="high"/><figcaption>Behind the scenes.</figcaption></figure>
      <div class="intro-copy">
        <a class="back-cover" href="/" data-photo-link>← Back to cover</a>
        <h1 id="tech-heading" data-tech-title>Creative Tech & Content Systems</h1>
        <p>I’m a creator with a Computer Science background. I’ve built an audience funnel, plan topics and film for a 7M-follower creator, and use AI tools in my workflow.</p>
        <dl><div><dt>Creative</dt><dd>Research, scripts, filming, editing & colour grading.</dd></div><div><dt>Technical & operational</dt><dd>Web development, production planning & AI workflows.</dd></div></dl>
        <SocialRail inline horizontal />
      </div>
    </section>
    <section id="selected-work" class="selected" aria-label="Audience and content systems">
      <article id="audience-results" class="work-row">
        <AudienceProof variant="1" />
      </article>
      <article id="audience-funnel" class="work-row">
        <CreativeTechGraphic kind="audience" />
      </article>
      <article id="creative-production" class="work-row">
        <CreativeTechGraphic kind="production" />
      </article>
    </section>
    <div class="contact-section"><Hero heading="Let’s talk about your project." description="Have an audience to grow or a content process to improve? Let’s talk through what you need, your timeline and whether we’re a good fit." /></div>
  </main>
  <Footer />
</Base>
<style>
  .tech-page{--section-gap:40px;display:grid;gap:var(--section-gap);max-width:var(--container-page);margin:auto;padding:40px 32px}
  .introduction{display:grid;grid-template-columns:1.1fr 1fr;gap:clamp(28px,5vw,72px);align-items:center}
  .portrait{width:100%;margin:0;padding:9px;background:white;box-shadow:0 3px 10px #23382d18}
  .portrait img{display:block;width:100%;height:auto;aspect-ratio:4/3;object-fit:cover;object-position:50% 45%}
  .back-cover{display:inline-block;margin-bottom:22px;font-size:var(--text-caption);text-underline-offset:5px}.back-cover:hover{text-decoration:underline}
  figcaption{font-size:var(--text-caption);line-height:1.5;padding:8px 2px 2px}
  .intro-copy{max-width:48ch}
  h1{font-size:var(--text-hero);line-height:1.1;letter-spacing:-.035em;margin-bottom:16px}
  .intro-copy p{font-size:var(--text-body);line-height:1.6;margin-bottom:20px}
  dl{margin:28px 0 0;display:grid;gap:18px}dt{font-size:var(--text-body);font-weight:650}dd{margin:4px 0 0;font-size:var(--text-body);color:var(--color-ink-dim)}
  .selected{display:grid;gap:48px;width:100%;max-width:var(--graphic-stage-width);margin-inline:auto}
  .work-row{min-width:0;scroll-margin-top:100px}
  @media(max-width:700px){.tech-page{--section-gap:32px;padding:40px 24px}.introduction{grid-template-columns:1fr;gap:32px}.portrait{max-width:320px}}
</style>
