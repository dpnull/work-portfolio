---
import Base from "../layouts/Base.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import site from "../data/site.json";
const linkedin = site.social.find(profile => profile.id === "linkedin")!;
---
<Base title="Creative Tech & Content Systems — Dom Przewozny" description="Content, technology and hands-on operations. Explore Dom’s audience funnel, creative production experience and portfolio build.">
  <Header active="creative-tech" />
  <main>
    <section class="tech-intro wrap" aria-labelledby="tech-heading">
      <div class="intro-copy">
        <p class="eyebrow">Creative × Technical × Operator</p>
        <h1 id="tech-heading">The thinking.<br/>The making.<br/><span>The system behind it.</span></h1>
        <p class="lede">I’m Dom. I connect content, technology and production to take an idea through to something that works.</p>
        <p class="intro-detail">Computer Science background. Creator experience. Hands-on with research, filming, editing, production planning and AI workflows.</p>
        <nav class="intro-links" aria-label="Creative tech sections"><a href="#selected-work">Explore selected work ↓</a><a href={linkedin.href} target="_blank" rel="noopener noreferrer">LinkedIn ↗</a></nav>
      </div>
      <figure class="intro-portrait"><img src="/work-with-me.webp" alt="Dom overlooking the city at sunset" width="1000" height="1000" fetchpriority="high"/><figcaption>Dom Przewozny / Creative tech & content systems</figcaption></figure>
    </section>
    <section class="selected wrap" id="selected-work" aria-labelledby="selected-heading">
      <div class="section-heading"><h2 id="selected-heading">Selected work</h2><p>Across audience, production and technology.</p></div>

      <article class="case" id="audience-funnel">
        <div class="case-summary"><p class="eyebrow">01 / Own audience · Growth systems</p><h3>From attention<br/>to audience insight.</h3><p>A self-built funnel connecting social content with a 28-question assessment and an email audience.</p><div class="case-stat"><strong>28</strong><span>questions capturing<br/>locations, needs & gaps</span></div></div>
        <div class="case-detail">
          <div><h4>The problem</h4><p>Social engagement tells only part of the story. Understanding people’s needs takes a more direct conversation.</p></div>
          <div><h4>What I built</h4><p>A funnel from my own social audience into a questionnaire capturing locations, needs and gaps, alongside email collection.</p></div>
          <div><h4>What it connects</h4><p>Content, audience research and an owned contact channel. The assessment gives context to the people behind the follower count.</p></div>
          <a class="text-link" href="/ugc#work">See the audience-tested content →</a>
        </div>
      </article>

      <article class="case" id="creative-production">
        <div class="case-summary"><p class="eyebrow">02 / Creator work · Production</p><h3>From the topic<br/>to the shoot.</h3><p>Topic planning and filming for a creator with a 7M-follower audience.</p><div class="case-stat"><strong>7M</strong><span>followers on the creator’s account<br/>My role: topic planning & filming</span></div></div>
        <div class="case-detail">
          <div><h4>The work</h4><p>Connecting what a video should say with what needs to happen on set. My contribution is planning topics and filming.</p></div>
          <div><h4>How I work</h4><p>Research and creative decisions sit alongside practical production planning. Across my production work, that includes budgets, schedules, locations and crew, through to shooting, drone work, editing and colour grading.</p></div>
          <div><h4>The tools behind it</h4><p>Premiere Pro and CapCut for the edit; Notion for organising the work around it. Creative judgment and operational follow-through are part of the same process.</p></div>
          <a class="text-link" href="/ugc">Explore my own video portfolio →</a>
        </div>
      </article>

      <article class="case" id="portfolio-build">
        <div class="case-summary"><p class="eyebrow">03 / Personal project · Web development</p><h3>One portfolio.<br/>Two ways in.</h3><p>The site you’re on: a home for both video production and creative tech.</p><ul class="tool-list" aria-label="Portfolio technology"><li>Astro</li><li>TypeScript</li><li>Tailwind CSS</li></ul></div>
        <div class="case-detail">
          <div><h4>The problem</h4><p>A brand commissioning a video and a team looking for a creative operator need different evidence. One crowded page asks both to do the sorting.</p></div>
          <div><h4>What I built</h4><p>A shared homepage with two dedicated paths, using AI-assisted development. The UGC page leads with video; this page gives the systems and production work room to breathe.</p></div>
          <div><h4>The working details</h4><p>Responsive layouts, self-hosted video, on-demand loading and one-at-a-time playback in the work grid. Shared components keep the two portfolios connected.</p></div>
          <a class="text-link" href="/">Explore the two-path homepage →</a>
        </div>
      </article>
    </section>
    <section class="approach" aria-labelledby="approach-heading"><div class="wrap">
      <div class="section-heading"><h2 id="approach-heading">How I approach the work</h2><p>Creative judgment. Technical curiosity. Follow-through.</p></div>
      <ol><li><span>01</span><h3>Understand</h3><p>The audience, the problem and what a useful outcome looks like.</p></li><li><span>02</span><h3>Make</h3><p>The content, prototype or workflow that moves the idea forward.</p></li><li><span>03</span><h3>Improve</h3><p>Use feedback to refine the work and make the next round easier.</p></li></ol>
    </div></section>
    <section class="work-together wrap" aria-labelledby="together-heading">
      <div><p class="eyebrow">Projects, ongoing support & team opportunities</p><h2 id="together-heading">Need someone who can<br/>connect the pieces?</h2><p>Let’s talk about content, production or the systems around them. Send me the problem, the team and what you’re trying to make happen.</p></div>
      <div class="contact-links"><a class="contact-button" href={`mailto:${site.email}`}>Talk to me about your project <span aria-hidden="true">↗</span></a><a class="text-link" href={linkedin.href} target="_blank" rel="noopener noreferrer">Experience & background on LinkedIn ↗</a><a class="text-link" href="/ugc">Looking for UGC? See the video portfolio →</a></div>
    </section>
  </main>
  <Footer />
</Base>
<style>
  .wrap{max-width:var(--container-page);margin:auto;padding-inline:32px}
  .tech-intro{display:grid;grid-template-columns:1.25fr .75fr;gap:64px;padding-block:72px 80px;align-items:center}
  .eyebrow{font-size:13px;line-height:1.5;color:var(--color-ink-dim);margin-bottom:20px;letter-spacing:.035em}
  h1{font-size:clamp(40px,5vw,66px);line-height:1.04;letter-spacing:-.045em;margin-bottom:28px}h1 span{color:var(--color-ink-dim)}
  .lede{font-size:21px;line-height:1.45;max-width:43ch;margin-bottom:18px}
  .intro-detail{font-size:16px;line-height:1.65;max-width:50ch}
  .intro-links{display:flex;flex-wrap:wrap;gap:24px;margin-top:30px;font-size:15px}.intro-links a{text-decoration:underline;text-underline-offset:5px}
  .intro-portrait{margin:0;border:1px solid var(--color-line);padding:10px;background:var(--color-plate)}
  .intro-portrait img{width:100%;height:auto;aspect-ratio:4/5;object-fit:cover;object-position:center}
  figcaption{padding:12px 4px 4px;font-size:12px;line-height:1.5}
  .section-heading{display:flex;flex-wrap:wrap;justify-content:space-between;align-items:baseline;gap:16px;padding-bottom:28px}
  h2{font-size:clamp(28px,3.4vw,42px);line-height:1.12;letter-spacing:-.035em}.section-heading>p{font-size:15px;color:var(--color-ink-dim)}
  .case{display:grid;grid-template-columns:1fr 1fr;gap:72px;border-top:1px solid var(--color-line);padding:48px 0 56px;scroll-margin-top:100px}
  .case-summary h3{font-size:clamp(30px,3.4vw,44px);line-height:1.1;letter-spacing:-.035em;margin-bottom:20px}
  .case-summary>p:not(.eyebrow){font-size:17px;line-height:1.6;max-width:38ch}
  .case-stat{display:flex;align-items:center;gap:20px;margin-top:32px;padding-top:24px;border-top:1px solid var(--color-line)}
  .case-stat strong{font-size:64px;line-height:1;letter-spacing:-.05em;font-weight:500}.case-stat span{font-size:14px;line-height:1.6}
  .case-detail{display:grid;gap:24px;align-content:start}.case-detail h4{font-size:14px;font-weight:650;margin-bottom:8px}
  .case-detail p{font-size:16px;line-height:1.65;max-width:51ch;color:var(--color-ink-dim)}
  .text-link{font-size:15px;line-height:1.6;text-decoration:underline;text-underline-offset:5px;width:fit-content}
  .tool-list{list-style:none;display:flex;flex-wrap:wrap;gap:8px;margin-top:28px}.tool-list li{border:1px solid var(--color-line);padding:8px 12px;font-size:13px}
  .approach{background:var(--color-cinema);color:var(--color-cinema-ink);padding-block:48px;margin-top:12px}.approach .section-heading>p{color:var(--color-cinema-dim)}
  .approach ol{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));list-style:none;gap:32px;margin-top:12px}
  .approach li{border-top:1px solid var(--color-cinema-line);padding-top:20px}.approach li>span{font-family:var(--font-mono);font-size:13px;color:var(--color-cinema-dim)}
  .approach h3{font-size:24px;margin:16px 0 12px;letter-spacing:-.02em}.approach li p{font-size:16px;line-height:1.6;color:var(--color-cinema-dim);max-width:29ch}
  .work-together{display:grid;grid-template-columns:1.2fr 1fr;align-items:center;gap:64px;padding-block:64px}
  .work-together p:not(.eyebrow){font-size:17px;line-height:1.6;margin-top:20px;max-width:45ch}.contact-links{display:grid;gap:22px}
  .contact-button{display:flex;align-items:center;justify-content:space-between;gap:24px;padding:18px 20px;background:var(--color-accent);color:var(--color-accent-ink);font-size:16px;font-weight:600;line-height:1.4}
  .contact-button:hover{background:var(--color-ink)}
  @media(max-width:900px){.tech-intro{gap:32px;grid-template-columns:1.1fr .9fr}.case{gap:40px}.work-together{gap:32px;grid-template-columns:1fr 1fr}}
  @media(max-width:700px){.tech-intro{grid-template-columns:1fr;padding-block:40px}.intro-portrait{max-width:360px}.case{grid-template-columns:1fr;gap:32px;padding-block:32px 40px}.case-stat strong{font-size:48px}.approach ol{grid-template-columns:1fr;gap:28px}.approach li p{max-width:42ch}.work-together{grid-template-columns:1fr;padding-block:40px}.wrap{padding-inline:24px}.section-heading{padding-top:16px}.case-summary>p:not(.eyebrow){max-width:45ch}}
</style>
