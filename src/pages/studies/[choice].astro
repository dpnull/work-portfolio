---
import Base from '../../layouts/Base.astro';
import site from '../../data/site.json';
export function getStaticPaths() { return ['1','2','3'].map(choice => ({ params: { choice } })); }
const choice = Astro.params.choice;
const names = ['Photo notes', 'Portfolio spread', 'Work shelf'];
---
<Base title={`Dom — ${names[Number(choice)-1]}`} description="Videos, creative production and things I’ve built. A portfolio by Dom Przewozny.">
  <div class:list={['study', `study-${choice}`]}>
    <header class="masthead">
      <a class="wordmark" href="/">@dpy2k</a>
      <nav aria-label="Portfolio"><a href="/ugc">UGC & video</a><a href="/creative-tech">Creative tech</a><a href={`mailto:${site.email}`}>Email me</a></nav>
    </header>
    <main>
      <section class="intro" aria-label="About Dom">
        <div class="intro-copy"><p class="eyebrow">A little of what I do</p><h1>Hi, I’m Dom.</h1><p>Creator. Computer Science background.<br/>Usually making something.</p><p class="bio">I make videos, plan and film content, and build things behind the scenes.</p><div class="socials"><a href={site.social[0].href}>Instagram</a><a href={site.social[2].href}>LinkedIn</a></div></div>
        <figure class="portrait"><img src="/hero-portrait-m-800.webp" alt="Dom at dusk, with palm trees behind him" width="800" height="1067" fetchpriority="high"/><figcaption>Me, off-script.</figcaption></figure>
      </section>
      <section class="collection" aria-label="Selected work">
        <div class="collection-heading"><h2>{choice === '2' ? 'A few things I’ve made.' : 'Selected work'}</h2><a href="/ugc#work">All videos</a></div>
        {choice === '3' && <div class="filters" role="group" aria-label="Filter selected work"><button type="button" data-filter="all" aria-pressed="true">Everything</button><button type="button" data-filter="video" aria-pressed="false">Videos</button><button type="button" data-filter="tech" aria-pressed="false">Things I’ve built</button></div>}
        <div class="pieces">
          <figure class="piece film" data-kind="video"><div class="media"><video controls playsinline preload="none" poster="/clips/unrot.webp" aria-label="Unrot brand film"><source src="/clips/unrot.mp4" type="video/mp4"/></video></div><figcaption><small>Brand collaboration · Unrot</small><h3>A night, two ways.</h3><p>A dialogue-free film about app accountability.</p><a href="/ugc">More UGC & video</a></figcaption></figure>
          <article class="piece build" data-kind="tech"><small>Creative tech · Own project</small><h3>Beyond the<br/>view count.</h3><p>I built a 28-question audience assessment to understand the people watching: their locations, needs and gaps.</p><details><summary>A little more about it</summary><p>The assessment collected email addresses alongside audience responses, connecting my content to a better understanding of the people behind the views.</p></details><a href="/creative-tech">See the work behind the content</a><span class="note-signature" aria-hidden="true">Dom / project notes</span></article>
          <figure class="piece personal" data-kind="video"><div class="media"><video controls playsinline preload="none" poster="/clips/water.webp" aria-label="Why I Drink So Much Water"><source src="/clips/water.mp4" type="video/mp4"/></video></div><figcaption><small>Own audience · Educational video</small><h3>Why I Drink So Much Water</h3><p>An everyday habit, told through appearance.</p></figcaption></figure>
          <article class="piece experience" data-kind="tech"><img src="/work-with-me.webp" alt="Dom overlooking the city at sunset" width="800" height="800" loading="lazy"/><div><small>Behind the scenes</small><h3>Planning. Filming.<br/>Figuring it out.</h3><p>I plan topics and film for a 7M-follower creator. Production planning and creative problem-solving are part of the work, too.</p><a href="/creative-tech">More about my experience</a></div></article>
        </div>
      </section>
    </main>
    <footer><span>Dom Przewozny</span><a href="/ugc#work-with-me">Brand collaborations, bundles & ongoing work</a><a href={`mailto:${site.email}`}>Let’s talk</a></footer>
  </div>
  <nav class="comparison" aria-label="Compare design options"><span>Try a version</span>{names.map((name,i)=><a href={`/studies/${i+1}`} aria-current={Number(choice)===i+1?'page':undefined}>{i+1}<span>{name}</span></a>)}</nav>
</Base>
<style>
  .study{max-width:1400px;margin:auto;padding:0 48px 110px}.masthead{display:flex;align-items:center;justify-content:space-between;padding:26px 0}.wordmark{font-size:23px;font-weight:650;letter-spacing:-.05em}.masthead nav{display:flex;gap:30px;font-size:15px}a{text-underline-offset:5px}a:hover{text-decoration:underline}h1,h2,h3,p,figure{margin:0}h1{font-size:42px;line-height:1.08;letter-spacing:-.045em;font-weight:500}h2{font-size:20px;font-weight:500}h3{font-size:24px;line-height:1.15;letter-spacing:-.025em;font-weight:500}.eyebrow,small{font-size:14px;line-height:1.4;color:var(--color-ink-dim)}.eyebrow{margin-bottom:18px}.intro-copy>p:not(.eyebrow){font-size:18px;line-height:1.5;margin-top:20px}.intro-copy .bio{font-size:16px!important;max-width:29ch}.socials{display:flex;gap:18px;font-size:14px;margin-top:24px}.portrait{background:white;padding:9px 9px 0}.portrait img{width:100%;aspect-ratio:4/5;object-fit:cover}.portrait figcaption{padding:10px 2px;font-size:14px}.collection-heading{display:flex;align-items:center;justify-content:space-between;margin-bottom:26px}.collection-heading>a{font-size:14px}.media video{width:100%;aspect-ratio:9/16;object-fit:cover;background:var(--color-ink)}.piece{min-width:0}.piece figcaption{padding-top:15px}.piece h3{margin:8px 0 10px}.piece p{font-size:16px;line-height:1.5}.piece a{display:inline-block;margin-top:17px;font-size:14px;text-decoration:underline}.build{padding:28px;background:var(--color-plate);align-self:start}.build h3{font-size:32px;margin:24px 0}.build details{margin-top:24px;font-size:14px}.build summary{cursor:pointer;text-decoration:underline;text-underline-offset:4px}.build details p{margin-top:14px}.note-signature{display:block;margin-top:34px;font:12px var(--font-mono);color:var(--color-ink-dim)}.experience img{width:100%;aspect-ratio:4/3;object-fit:cover;object-position:50% 45%}.experience>div{padding-top:18px}footer{display:flex;justify-content:space-between;gap:24px;margin-top:75px;font-size:14px}footer>a:nth-child(2){color:var(--color-ink-dim)}.comparison{position:fixed;bottom:18px;left:50%;transform:translateX(-50%);z-index:10000;background:var(--color-ink);color:var(--color-ground);display:flex;align-items:center;gap:5px;padding:7px;box-shadow:0 5px 25px #0002;max-width:calc(100% - 20px)}.comparison>span{font-size:12px;padding:0 10px;white-space:nowrap}.comparison a{display:flex;gap:8px;align-items:center;padding:10px 13px;font-size:14px;white-space:nowrap}.comparison a[aria-current]{background:var(--color-ground);color:var(--color-ink)}
  /* 01: an informal collection of prints, with breathing room between objects. */
  .study-1 main{display:grid;grid-template-columns:34% 1fr;gap:7%;padding-top:38px}.study-1 .intro{display:flex;flex-direction:column;gap:32px}.study-1 .portrait{order:-1;width:85%;transform:rotate(-4deg);margin:10px 0 12px 10px}.study-1 .intro-copy{padding-left:18px}.study-1 .pieces{display:grid;grid-template-columns:1fr 1fr;gap:48px 32px;align-items:start}.study-1 .film{background:white;padding:9px 9px 18px;transform:rotate(2deg)}.study-1 .film figcaption{padding-inline:6px}.study-1 .build{margin-top:65px;transform:rotate(-2deg)}.study-1 .personal{width:85%;margin:0 auto;transform:rotate(-2deg)}.study-1 .experience{margin-top:28px}.study-1 .media video{max-height:390px}.study-1 .piece{transition:transform .25s}.study-1 .piece:hover,.study-1 .piece:focus-within{transform:rotate(0)}
  /* 02: a compact personal index beside a white editorial portfolio spread. */
  .study-2 main{display:grid;grid-template-columns:250px 1fr;gap:55px;margin-top:44px;align-items:start}.study-2 .intro{position:sticky;top:32px;display:flex;flex-direction:column;gap:28px}.study-2 .portrait{width:155px;order:-1;transform:rotate(-3deg)}.study-2 h1{font-size:35px}.study-2 .collection{background:var(--color-plate);padding:32px 36px}.study-2 .pieces{display:grid;grid-template-columns:1fr 1fr;gap:45px 30px}.study-2 .film{grid-column:2;grid-row:1 / 3}.study-2 .build{grid-column:1;grid-row:1;padding:0;background:none}.study-2 .build h3{font-size:35px}.study-2 .experience{grid-column:1;grid-row:2}.study-2 .experience img{display:none}.study-2 .personal{grid-column:1 / -1;display:grid;grid-template-columns:43% 1fr;gap:30px;align-items:center}.study-2 .personal video{max-height:310px}.study-2 .film video{max-height:510px}.study-2 .note-signature{display:none}
  /* 03: the work is immediately browseable; biography stays in the margin. */
  .study-3 .intro{display:flex;gap:30px;align-items:center;margin:28px 0 42px}.study-3 .intro-copy{flex:1;display:grid;grid-template-columns:1fr 1fr;column-gap:40px}.study-3 .eyebrow{display:none}.study-3 h1{grid-column:1;grid-row:1}.study-3 .intro-copy>p:not(.eyebrow){grid-column:2;grid-row:1;margin:0;font-size:17px}.study-3 .intro-copy .bio{grid-row:2!important;margin-top:14px!important;max-width:38ch}.study-3 .socials{grid-column:1;grid-row:2}.study-3 .portrait{width:105px;order:-1;padding:5px;transform:rotate(-4deg)}.study-3 .portrait figcaption{display:none}.study-3 .collection-heading{display:none}.filters{display:flex;gap:25px;margin-bottom:26px}.filters button{font-size:16px;cursor:pointer;padding:8px 0;color:var(--color-ink-dim)}.filters button[aria-pressed=true]{color:var(--color-ink);text-decoration:underline;text-underline-offset:8px}.study-3 .pieces{display:grid;grid-template-columns:repeat(4,1fr);gap:26px;align-items:start}.study-3 .build{margin-top:65px}.study-3 .personal{margin-top:30px}.study-3 .experience{margin-top:95px}.study-3 .build h3{font-size:27px}.study-3 .build{padding:23px}.study-3 .piece[hidden]{display:none}
  @media(min-width:1500px){.study-1 .media video{max-height:470px}}
  @media(max-width:1000px){.study{padding-inline:28px}.study-1 main{gap:5%;grid-template-columns:30% 1fr}.study-1 .build{padding:20px}.study-1 .build h3{font-size:27px}.study-2 main{grid-template-columns:210px 1fr;gap:28px}.study-2 .collection{padding:25px}.study-3 .pieces{grid-template-columns:repeat(2,1fr)}.study-3 .experience{margin-top:25px}.study-3 .media video{max-height:470px}}
  @media(max-width:700px){.study{padding:0 22px 110px}.masthead{align-items:start;gap:22px}.masthead nav{gap:14px;flex-wrap:wrap;justify-content:flex-end;font-size:14px}.wordmark{font-size:20px;white-space:nowrap}h1{font-size:34px}.study-1 main,.study-2 main{display:block;padding-top:15px;margin-top:0}.study-1 .intro,.study-2 .intro{position:static;display:grid;grid-template-columns:120px 1fr;gap:20px;align-items:center;margin-bottom:38px}.study-1 .portrait,.study-2 .portrait{width:100%;margin:0}.study-1 .intro-copy{padding:0}.eyebrow{display:none}.intro-copy>p:not(.eyebrow){font-size:16px;margin-top:12px}.intro-copy .bio{display:none}.socials{gap:14px;margin-top:14px}.portrait figcaption{font-size:12px}.study-1 .pieces{gap:30px 20px}.study-1 .build{margin-top:28px}.study-1 .build h3{font-size:24px}.study-1 .build{padding:16px}.piece h3{font-size:21px}.piece p{font-size:16px}.study-1 .personal{width:100%}.study-2 .collection{padding:22px 18px}.study-2 .pieces{gap:28px 18px}.study-2 .build h3{font-size:27px}.study-2 .personal{gap:20px}.study-3 .intro{gap:20px;margin-top:20px}.study-3 .intro-copy{display:block}.study-3 .intro-copy>p:not(.eyebrow){margin-top:12px}.study-3 .portrait{flex:0 0 90px}.study-3 .pieces{gap:28px 20px}.study-3 .build{margin-top:25px;padding:17px}.study-3 .build h3{font-size:25px}.filters{gap:20px;flex-wrap:wrap}.filters button{font-size:14px}footer{flex-wrap:wrap;margin-top:45px}footer>a:nth-child(2){order:3;width:100%}.comparison>span{display:none}.comparison a{padding:9px 13px;font-size:13px}.comparison a>span{display:none}.comparison a[aria-current]>span{display:inline}}
  @media(max-width:420px){.study-1 .pieces,.study-2 .pieces,.study-3 .pieces{grid-template-columns:1fr}.study-1 .piece,.study-3 .piece{margin:0;width:100%}.study-2 .piece{grid-column:auto;grid-row:auto}.study-2 .personal{display:block}.study-1 .media video,.study-3 .media video{max-height:460px}.study-2 .film{order:-1}.study-1 .intro,.study-2 .intro{grid-template-columns:90px 1fr}h1,.study-2 h1{font-size:30px}}
</style>
<script>
  const videos = [...document.querySelectorAll<HTMLVideoElement>('.study video')];
  videos.forEach(video => video.addEventListener('play', () => videos.forEach(other => { if (other !== video) other.pause(); })));
  const filters = document.querySelectorAll<HTMLButtonElement>('[data-filter]');
  filters.forEach(button => button.addEventListener('click', () => {
    filters.forEach(item => item.setAttribute('aria-pressed', String(item === button)));
    document.querySelectorAll<HTMLElement>('[data-kind]').forEach(piece => {
      piece.hidden = button.dataset.filter !== 'all' && piece.dataset.kind !== button.dataset.filter;
      if (piece.hidden) piece.querySelector('video')?.pause();
    });
  }));
</script>
