---
import Base from "../layouts/Base.astro";
import Header from "../components/Header.astro";
import Proof from "../components/Proof.astro";
import WorkGrid from "../components/WorkGrid.astro";
import AudienceOptions from "../components/AudienceOptions.astro";
import Footer from "../components/Footer.astro";
---

<Base title="UGC & Video Production — Dom Przewozny" description="Creator-led UGC, educational social videos and brand films. Explore Dom’s work, audience results and video production services.">
  <Header active="ugc" />
  <main>
    <AudienceOptions opening />
    <nav class="page-links" aria-label="UGC sections"><a href="#work">Explore the videos ↓</a><a href="#work-with-me">Services & pricing</a></nav>
    <Proof />
    <WorkGrid />
    <AudienceOptions />
    <aside class="other-path"><p>Looking for the systems behind the content?</p><a href="/creative-tech">Explore creative tech & content systems →</a></aside>
  </main>
  <Footer />
</Base>
<style>
  .page-links,.other-path{max-width:var(--container-page);margin:auto;padding:0 32px 32px;display:flex;flex-wrap:wrap;gap:20px;justify-content:space-between;font-size:16px}
  .page-links a,.other-path a{text-decoration:underline;text-underline-offset:5px}.other-path{padding-block:32px;line-height:1.6}
  @media(max-width:639px){.page-links,.other-path{padding-inline:24px}}
</style>
