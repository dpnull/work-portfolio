---
import Base from "../layouts/Base.astro";
import Proof from "../components/Proof.astro";
import WorkGrid from "../components/WorkGrid.astro";
import AudienceOptions from "../components/AudienceOptions.astro";
import Footer from "../components/Footer.astro";
---

<Base title="UGC & Video Production — Dom Przewozny" description="Creator-led videos for grooming, fitness, wellbeing and tech brands. Explore Dom’s work and start with a three-video pilot from US$600." photoTransition>
  <main>
    <section class="portfolio-opening" aria-labelledby="ugc-heading">
      <figure class="opening-print">
        <img data-ugc-photo src="/clips/its-all-a-lie.webp" alt="A frame from Dom’s personal cinematic short, It’s all a lie" width="720" height="1280" fetchpriority="high" />
        <figcaption>It’s all a lie <span>Personal film</span></figcaption>
      </figure>
      <div class="opening-copy">
        <a class="back-cover" href="/" data-photo-link>← Back to cover</a>
        <h1 id="ugc-heading" data-ugc-title>UGC & Video</h1>
        <p>Short videos for grooming, fitness, wellbeing and tech brands. I handle the idea, script, filming and edit.</p>
        <nav class="opening-links" aria-label="UGC sections"><a href="#work">Explore the videos ↓</a><a href="#work-with-me">Services & pricing</a></nav>
      </div>
    </section>
    <WorkGrid />
    <Proof />
    <AudienceOptions />
    <aside class="other-path"><p>Need help planning and producing regular content?</p><a href="/creative-tech">Explore content production & systems →</a></aside>
  </main>
  <Footer />
</Base>
<style>
  .portfolio-opening{max-width:var(--container-page);margin:auto;padding:36px 32px 8px;display:grid;grid-template-columns:minmax(0,1.1fr) minmax(0,1fr);gap:clamp(28px,5vw,72px);align-items:center}
  .opening-print{margin:0;padding:9px 9px 0;background:white;box-shadow:0 3px 10px #23382d18}
  .opening-print img{display:block;width:100%;height:auto;aspect-ratio:4/3;object-fit:cover;object-position:50% 35%}
  .opening-print figcaption{display:flex;justify-content:space-between;gap:16px;padding:12px 5px;font-size:var(--text-caption)}
  .opening-print figcaption span{color:var(--color-ink-dim)}
  .back-cover{font-size:var(--text-caption);text-underline-offset:5px}
  .back-cover:hover{text-decoration:underline}
  .opening-copy h1{font-size:var(--text-hero);font-weight:500;letter-spacing:-.04em;line-height:1.1;margin:26px 0 18px;width:fit-content}
  .opening-copy p{font-size:var(--text-body);line-height:1.5;max-width:30ch}
  .opening-links{display:flex;flex-wrap:wrap;gap:16px 24px;margin-top:26px;font-size:var(--text-body)}
  .opening-links a{text-decoration:underline;text-underline-offset:5px}
  @media(max-width:639px){.portfolio-opening{padding:24px 24px 0;grid-template-columns:1fr;gap:22px}.opening-print{max-width:440px;width:100%;margin:auto}.opening-copy h1{margin:16px 0 12px}.opening-copy p{font-size:var(--text-body);max-width:none}.opening-links{margin-top:18px}}
  .page-links,.other-path{max-width:var(--container-page);margin:auto;padding:0 32px 32px;display:flex;flex-wrap:wrap;gap:20px;justify-content:space-between;font-size:var(--text-body)}
  .page-links a,.other-path a{text-decoration:underline;text-underline-offset:5px}.other-path{padding-block:32px;line-height:1.6}
  @media(max-width:639px){.page-links,.other-path{padding-inline:24px}}
</style>
