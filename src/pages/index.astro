---
import Base from "../layouts/Base.astro";
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import Stats from "../components/Stats.astro";
import WorkGrid from "../components/WorkGrid.astro";
import site from "../data/site.json";
---

<Base
  title={site.meta.title}
  description={site.meta.description}
>
  <Header />
  <main>
    <Hero />
    <Stats />
    <WorkGrid />
    {/* Blocks 3-4: lanes + rates (#rates), results, about, footer (#contact) */}
  </main>
  <footer id="contact" class="border-line text-ink-dim mx-auto max-w-(--container-page) border-t px-6 py-8 text-xs sm:px-8">
    &copy; {new Date().getFullYear()} {site.name}
  </footer>
</Base>
