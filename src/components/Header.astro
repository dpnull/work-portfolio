---
import site from "../data/site.json";
// THE RAIL (Dom's pick from a five-option board, 2026-09-07).
// Full-bleed row of fused hairline cells — same construction as the stats strip:
// neighbours share one 1px `line` rule, there are no gaps, and the button IS the
// cell. Order at >=1024: wordmark | Work | Rates | email | Book a free video call.
//
// Dom's revisions (2026-09-07, second pass):
//  · STICKY. The rail freezes to the top of the viewport, so it needs an opaque
//    ground of its own — the hero photo scrolls underneath it.
//  · NO LIME. The CTA was a lime fill; it is now ground with an `ink` border.
//    Lime survives nowhere on the page now — the hero's lede plates went white
//    on 2026-09-07 too.
//  · INSTANT hover. No transition on any cell: the invert snaps.
//  · The email is set in the sans, not Kode Mono.
//  · The CTA reads "Book a free video call", which is too long for a third of a
//    phone row, so the phone tiers were re-cut: tier one is wordmark + CTA,
//    tier two is Work | Rates. The CTA is therefore a direct child of <header>
//    rather than a child of <nav> — it has to be able to share tier one with
//    the wordmark while the nav wraps below it.
//
// The CTA's border is 1px on all four sides — the same weight as every other
// rule in the rail (Dom, 2026-09-07; it was 2px and read as heavy). It still
// sits 1px proud of the row (`margin-block: -1px` on a stretched flex item),
// which now lands its ink border exactly ON the rail's top and bottom
// hairlines rather than beside them. Keep the two together: drop the negative
// margin and the button gains a doubled edge.
//
// The email CELL COPIES rather than opening a mail client (Dom, 2026-09-07):
// clicking it writes the address to the clipboard and the label flashes
// "Copied" for 1.6s. `navigator.clipboard.writeText` needs no permission
// prompt for a WRITE — only reads prompt — provided it runs in a secure
// context off a real user gesture, which a click handler is. The
// `execCommand` path below it is the fallback for a non-secure context
// (an http staging host) where the modern API is simply absent.
//
// 640–1023: the email cell is dropped and an empty flex spacer cell holds its
// slot, so the rail language survives. <640: the two tiers described above; no
// email on phones (see the open flag in PROGRESS.md; block 4's contact section
// is the fix).
---

<header class="rail">
  <a href="/" class="rail-cell rail-mark font-display text-lg font-semibold">{site.wordmark}</a>

  <nav aria-label="Primary" class="rail-nav">
    {site.nav.map((item) => (
      <a href={item.href} class="rail-cell rail-link text-sm">{item.label}</a>
    ))}
    <button
      type="button"
      class="rail-cell rail-email text-sm"
      data-copy-email={site.email}
      aria-label={`Copy email address ${site.email}`}
      title="Click to copy"
    >
      <span data-copy-label>{site.email}</span>
      <span class="sr-only" role="status" aria-live="polite" data-copy-status></span>
    </button>
    <div class="rail-spacer" aria-hidden="true"></div>
  </nav>

  <a href={site.bookUrl} class="rail-cell rail-cta text-sm font-semibold">Book a free video call</a>
</header>

<style>
  /* ── The rail itself ──────────────────────────────────────────────
     Phone first: two tiers inside one 90px border-box, so the hairlines
     are part of the height rather than added to it.
     Sticky, and opaque: the hero photo starts immediately below and has to
     pass behind it, not show through it. */
  .rail {
    position: sticky;
    top: 0;
    z-index: 50;
    display: flex;
    flex-wrap: wrap;
    height: 90px;
    background-color: var(--color-ground);
    border-top: 1px solid var(--color-line);
    border-bottom: 1px solid var(--color-line);
  }

  /* Tier one is wordmark + CTA, tier two is the nav. Both tiers are pinned to
     44px rather than left to `align-content: stretch`, which shares out the
     LEFTOVER space and so hands the taller line (the 18px wordmark) a taller
     tier. 1 + 44 + 44 + 1 = the 90px border box. */
  .rail-mark,
  .rail-nav,
  .rail-cta {
    height: 44px;
  }

  .rail-mark {
    flex: 1 1 auto;
    padding-inline: 24px;
    justify-content: flex-start;
    letter-spacing: -0.02em;
  }

  .rail-nav {
    display: flex;
    flex: 1 0 100%;
    order: 2; /* wraps to tier two, under the wordmark + CTA */
    border-top: 1px solid var(--color-line); /* the tier divider; gone at >=640 */
  }

  /* ── Cells ────────────────────────────────────────────────────────
     Every cell is the full height of its row, centred, and inverts on
     hover/focus — INSTANTLY, no transition (Dom, 2026-09-07). Neighbours
     share one rule: each cell owns its LEFT edge, the first of a row owns
     none (the viewport edge does that job). */
  .rail-cell {
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    white-space: nowrap;
    color: var(--color-ink);
  }

  .rail-nav > * {
    flex: 1 1 0;
    min-width: 0;
  }

  .rail-nav > * + * {
    border-left: 1px solid var(--color-line);
  }

  .rail-link {
    padding-inline: 12px;
  }

  /* The email is a <button>, not a mailto link (Dom, 2026-09-07: a mail client
     firing off unasked is a worse outcome than a copied string). So the UA's
     button chrome has to come off — .rail-cell supplies the rest. font-SIZE is
     left alone: the `text-sm` utility owns it, and the scoped selector here
     outranks it. */
  .rail-email {
    color: var(--color-ink-dim);
    padding-inline: 24px;
    appearance: none;
    background: none;
    border: 0;
    font-family: inherit;
    font-weight: inherit;
    letter-spacing: inherit;
    cursor: pointer;
  }

  /* While the "Copied" flash is up the cell goes full ink — the one moment it
     is louder than the two nav links beside it. Hover and focus are excluded
     BY HAND: the invert below is a plain `.rail-cell:hover`, which this
     attribute selector would otherwise outrank, painting ink on ink for the
     whole 1.6s — and you have to be hovering to have clicked. */
  .rail-email[data-copied]:not(:hover):not(:focus-visible) {
    color: var(--color-ink);
  }

  /* Hidden on phones; the spacer wakes up at 640, the email at 1024. */
  .rail-email,
  .rail-spacer {
    display: none;
  }

  /* ── The CTA ──────────────────────────────────────────────────────
     No fill: ground, ink text, a 1px ink border on all four sides — rail
     weight, not a heavier one — pulled 1px proud top and bottom so the border
     lands exactly on the rail's hairlines rather than beside them. What marks
     it as the button is that the border is INK while every other rule in the
     rail is `line`. On phones it shares tier one with the wordmark and its
     right border sits on the viewport edge. */
  .rail-cta {
    order: 1;
    flex: 0 0 auto;
    background-color: var(--color-ground);
    color: var(--color-ink);
    border: 1px solid var(--color-ink);
    margin-block: -1px;
    padding-inline: 16px;
  }

  /* Invert: ink ground, page-colour text. The rules stay put. */
  .rail-cell:hover,
  .rail-cell:focus-visible {
    background-color: var(--color-ink);
    color: var(--color-ground);
  }

  /* The global focus ring is ink, which vanishes against the inverted ink
     cell — same square 2px ring, recoloured and pulled inside so it also
     clears the viewport edge on the CTA. */
  .rail-cell:focus-visible {
    outline: 2px solid var(--color-ground);
    outline-offset: -6px;
  }

  /* ── Tablet: one 56px row, email swapped for an empty spacer cell ── */
  @media (min-width: 640px) {
    .rail {
      flex-wrap: nowrap;
      height: 56px;
    }
    /* auto = stretch again, so all three fill the single row */
    .rail-mark,
    .rail-nav,
    .rail-cta {
      height: auto;
    }
    .rail-mark {
      flex: 0 0 auto;
      padding-inline: 30px;
    }
    .rail-nav {
      flex: 1 1 auto;
      order: 0;
      border-top: 0;
    }
    .rail-nav > * {
      flex: 0 0 auto;
    }
    .rail-nav > *:first-child {
      border-left: 1px solid var(--color-line);
    }
    .rail-link {
      padding-inline: 28px;
    }
    .rail-cta {
      order: 0;
      padding-inline: 28px;
    }
    .rail-nav > .rail-spacer {
      display: block;
      flex: 1 1 0;
    }
  }

  /* ── Desktop: the email takes the middle back off the spacer ── */
  @media (min-width: 1024px) {
    .rail-nav > .rail-spacer {
      display: none;
    }
    .rail-nav > .rail-email {
      display: flex;
      flex: 1 1 0;
    }
  }
</style>

<script>
  // Progressive enhancement, deliberately JS-only: with scripts off the cell is
  // still the address, legible and selectable, which is what people do by hand
  // anyway. Nothing else on the rail depends on this running.
  document.querySelectorAll<HTMLButtonElement>("[data-copy-email]").forEach((button) => {
    const address = button.dataset.copyEmail ?? "";
    const label = button.querySelector<HTMLElement>("[data-copy-label]");
    const status = button.querySelector<HTMLElement>("[data-copy-status]");
    if (!address || !label || !status) return;

    let timer: number | undefined;

    async function write(text: string) {
      if (window.isSecureContext && navigator.clipboard) {
        try {
          await navigator.clipboard.writeText(text);
          return true;
        } catch {
          // Denied or unavailable — drop through to the legacy path.
        }
      }
      const scratch = document.createElement("textarea");
      scratch.value = text;
      scratch.setAttribute("readonly", "");
      scratch.style.cssText = "position:fixed;top:-9999px;opacity:0";
      document.body.append(scratch);
      scratch.select();
      let ok = false;
      try {
        ok = document.execCommand("copy");
      } catch {
        ok = false;
      }
      scratch.remove();
      return ok;
    }

    button.addEventListener("click", async () => {
      const ok = await write(address);
      window.clearTimeout(timer);

      // Sighted feedback is the label swap; the live region is the same news
      // for a screen reader, which would not otherwise hear the button's own
      // content change.
      label.textContent = ok ? "Copied" : "Copy failed";
      status.textContent = ok ? `Copied ${address}` : `Could not copy. The address is ${address}`;
      button.toggleAttribute("data-copied", ok);

      timer = window.setTimeout(() => {
        label.textContent = address;
        status.textContent = "";
        button.removeAttribute("data-copied");
      }, 1600);
    });
  });
</script>
