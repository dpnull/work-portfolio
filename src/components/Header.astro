---
import site from "../data/site.json";
const path = Astro.url.pathname.replace(/\.html$/, "").replace(/\/$/, "") || "/";
const nav = [
  { label: "UGC & Video", href: "/ugc" },
  { label: "Creative Tech", href: "/creative-tech" },
];
const contactUrl = nav.some(item => item.href === path) ? "#book-call" : "/ugc#book-call";
---

<header class="site-header" data-site-header transition:name="site-header" transition:persist="site-header" transition:animate="none">
  <a href="/" class="header-mark" aria-label={`${site.wordmark} — home`}>{site.wordmark}</a>
  <div class="polaroid-header">
  <div class="header-inset">
    <nav aria-label="Primary" class="header-nav">
      {nav.map((item) => (
        <a href={item.href} data-header-page={item.href} aria-current={path === item.href ? "page" : undefined} class="header-link">{item.label}</a>
      ))}
      <a href={contactUrl} class="header-cta" aria-label="Book a 15-minute call">
        <span class="cta-full">Book a 15-minute call</span><span class="cta-short" aria-hidden="true">Book a call</span><span aria-hidden="true">↗</span>
      </a>
    </nav>
  </div>
  </div>
</header>
<div class="header-space" aria-hidden="true"></div>

<style>
  /* One fixed paper header survives document swaps above the photo animation. */
  .site-header {
    position: fixed;
    inset: 0 0 auto;
    height: 88px;
    z-index: 100;
    pointer-events: none;
  }
  .polaroid-header {
    position: absolute;
    top: 28px;
    left: 50%;
    transform: translateX(-50%);
    pointer-events: auto;
    width: fit-content;
    max-width: calc(100% - 48px);
    margin-inline: auto;
    padding: 6px;
    background: var(--color-study-paper);
    border: 1px solid var(--color-header-edge);
    border-radius: var(--radius-header);
    box-shadow: 0 2px 3px var(--color-header-shadow), 0 12px 28px var(--color-header-shadow);
    color: var(--color-study-paper-ink);
  }
  .header-space { height: 112px; }
  .header-inset {
    padding: 0;
    background: var(--color-header-inset);
    border: 1px solid var(--color-header-edge);
  }
  .header-mark {
    position: absolute;
    z-index: 2;
    top: 30px;
    left: 24px;
    pointer-events: auto;
    display: grid;
    place-items: center;
    min-height: 40px;
    padding: 4px 12px;
    background: var(--color-study-pop);
    color: var(--color-study-pop-ink);
    font-size: 24px;
    font-weight: 650;
    letter-spacing: -.05em;
    line-height: 1.2;
    transform: rotate(-7deg);
    animation: sticker-float 6s ease-in-out infinite;
    box-shadow: 0 2px 3px var(--color-header-shadow);
    white-space: nowrap;
  }
  .header-nav { display: flex; align-items: center; justify-content: center; gap: 0; }
  .header-link, .header-cta {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 36px;
    padding: 6px 12px;
    font: 500 var(--text-nav)/1.3 var(--font-sans);
    color: inherit;
    white-space: nowrap;
    text-decoration: none;
  }
  .header-link[aria-current="page"] {
    text-decoration: underline;
    text-decoration-color: var(--color-accent);
    text-decoration-thickness: 2px;
    text-underline-offset: 5px;
  }
  .cta-short { display: none; }
  .header-cta { gap: 10px; background: var(--color-accent); color: var(--color-accent-ink); }
  .header-link:hover { background: var(--color-header-hover); }
  .header-cta:hover { background: var(--color-study-paper-ink); color: var(--color-study-paper); }
  .header-mark:focus-visible, .header-link:focus-visible, .header-cta:focus-visible {
    outline: 2px solid var(--color-study-paper-ink);
    outline-offset: 3px;
  }
  @keyframes sticker-float {
    50% { transform: translateY(-3px) rotate(-6deg); }
  }
  @media (prefers-reduced-motion: reduce) {
    .header-mark { animation: none; }
  }
  @media (max-width: 899px) {
    .polaroid-header { left: auto; right: 18px; transform: none; }
    .header-mark { left: 18px; top: 34px; font-size: 20px; min-height: 32px; padding-inline: 10px; }
  }
  @media (max-width: 639px) {
    .polaroid-header { max-width: calc(100% - 24px); }
    .header-link, .header-cta { padding-inline: 8px; font-size: var(--text-nav-compact); }
    .header-cta { gap: 6px; }
    .cta-full { display: none; }
    .cta-short { display: inline; }
  }
  @media (max-width: 439px) {
    .site-header { height: 96px; }
    .polaroid-header { top: 44px; left: 50%; right: auto; transform: translateX(-50%); }
    .header-mark { top: 8px; font-size: 16px; min-height: 24px; padding: 2px 8px; }
  }

</style>

<script>
  // The DOM is persisted, so update its route state before the incoming snapshot.
  const syncHeader = () => {
    const path = location.pathname.replace(/\.html$/, "").replace(/\/$/, "") || "/";
    document.querySelectorAll<HTMLAnchorElement>("[data-header-page]").forEach(link => {
      if (link.dataset.headerPage === path) link.setAttribute("aria-current", "page");
      else link.removeAttribute("aria-current");
    });
    const contact = document.querySelector<HTMLAnchorElement>(".header-cta");
    if (contact) contact.href = ["/ugc", "/creative-tech"].includes(path) ? "#book-call" : "/ugc#book-call";
  };
  document.addEventListener("astro:after-swap", syncHeader);
  document.addEventListener("astro:page-load", syncHeader);
  syncHeader();
</script>
