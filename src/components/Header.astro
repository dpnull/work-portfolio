---
import site from "../data/site.json";
interface Props { active?: "ugc" | "creative-tech"; }
const { active } = Astro.props;
const nav = [
  { label: "UGC & Video", href: "/ugc", id: "ugc" },
  { label: "Creative Tech", href: "/creative-tech", id: "creative-tech" },
];
// The CTA is the same cell on every page; only where it lands differs.
const ctaTarget = { ugc: "#book-call", "creative-tech": "#lets-talk" } as const;
const ctaHref = active ? ctaTarget[active] : "#contact";
// THE RAIL. Shared by /ugc and /creative-tech and IDENTICAL on both: same
// labels, same cell geometry at every width. The only thing that changes
// between the two pages is which link carries aria-current (an inset underline,
// so it costs no layout). The cover has its own wordmark-only header.
//
//  · Full-bleed row of fused hairline cells: neighbours share one 1px `line`
//    rule, no gaps. Sticky and opaque, since the page scrolls underneath it.
//  · >=1024: wordmark | UGC & Video | Creative Tech | email (grows) | Let's talk.
//    640-1023: the email is swapped for an empty spacer cell.
//    <640: two 44px tiers. Wordmark left and CTA right, then the two page
//    links as equal halves. A single row does not fit below ~400px.
//  · The CTA is a tinted cell with an accent underline, pulled 1px proud
//    (`margin-block: -1px`) so its border lands ON the rail's hairlines rather
//    than beside them. It is a child of <header>, not <nav>, so it can share
//    tier one with the wordmark on phones.
//  · Hover and focus invert a cell instantly (no transition; Dom, 2026-09-07).
//  · The email cell COPIES the address instead of opening a mail client, and
//    flashes "Copied" for 1.6s. No email cell below 1024.
//  · The rail has its own view-transition-name, so it holds still while the
//    page underneath cross-fades between the two portfolios. See the global
//    style block at the bottom.
---

<header class="rail">
  <a href="/" class="rail-cell rail-mark font-display text-lg font-semibold">{site.wordmark}</a>

  <nav aria-label="Primary" class="rail-nav">
    {nav.map((item) => (
      <a href={item.href} aria-current={active === item.id ? "page" : undefined} class="rail-cell rail-link text-sm">{item.label}</a>
    ))}
    <button
      type="button"
      class="rail-cell rail-email text-sm"
      data-copy-email={site.email}
      aria-label={`Copy email address ${site.email}`}
      title="Click to copy"
    >
      <span data-copy-label>{site.email}</span>
      <span class="sr-only" role="status" aria-live="polite" data-copy-status></span>
    </button>
    <div class="rail-spacer" aria-hidden="true"></div>
  </nav>

  <a href={ctaHref} class="rail-cell rail-cta text-sm font-semibold">
    <span>Let’s talk</span>
    <span class="rail-cta-mark" aria-hidden="true">↗</span>
  </a>
</header>

<style>
  /* ── The rail itself ──────────────────────────────────────────────
     Phone first: two tiers inside one 90px border-box, so the hairlines
     are part of the height rather than added to it.
     Sticky, and opaque: the hero photo starts immediately below and has to
     pass behind it, not show through it. */
  .rail {
    position: sticky;
    top: 0;
    z-index: 50;
    display: flex;
    flex-wrap: wrap;
    height: 90px;
    background-color: var(--color-ground);
    border-top: 1px solid var(--color-line);
    border-bottom: 1px solid var(--color-line);
    /* Its own snapshot during page swaps: see the global block below. */
    view-transition-name: site-rail;
  }

  /* Tier one is wordmark + CTA, tier two is the nav. Both tiers are pinned to
     44px rather than left to `align-content: stretch`, which shares out the
     LEFTOVER space and so hands the taller line (the 18px wordmark) a taller
     tier. 1 + 44 + 44 + 1 = the 90px border box. */
  .rail-mark,
  .rail-nav,
  .rail-cta {
    height: 44px;
  }

  .rail-mark {
    flex: 1 1 auto;
    padding-inline: 24px;
    letter-spacing: -0.02em;
  }

  .rail-nav {
    display: flex;
    flex: 1 0 100%;
    order: 2; /* wraps to tier two, under the wordmark + CTA */
    border-top: 1px solid var(--color-line); /* the tier divider; gone at >=640 */
  }

  /* ── Cells ────────────────────────────────────────────────────────
     Every cell is the full height of its row, centred, and inverts on
     hover/focus — INSTANTLY, no transition (Dom, 2026-09-07). Neighbours
     share one rule: each cell owns its LEFT edge, the first of a row owns
     none (the viewport edge does that job). */
  .rail-cell {
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    white-space: nowrap;
    color: var(--color-ink);
  }

  /* On phones the wordmark's cell is wide (it takes what the CTA leaves), so
     the mark sits at the left margin, opposite the CTA, not centred in it.
     After .rail-cell on purpose: same specificity, later wins. */
  .rail-mark {
    justify-content: flex-start;
  }

  .rail-nav > * {
    flex: 1 1 0;
    min-width: 0;
  }

  .rail-nav > * + * {
    border-left: 1px solid var(--color-line);
  }

  .rail-link {
    padding-inline: 12px;
  }
  .rail-link[aria-current="page"] { box-shadow: inset 0 -3px 0 var(--color-accent); }

  /* The email is a <button>, not a mailto link (Dom, 2026-09-07: a mail client
     firing off unasked is a worse outcome than a copied string). So the UA's
     button chrome has to come off — .rail-cell supplies the rest. font-SIZE is
     left alone: the `text-sm` utility owns it, and the scoped selector here
     outranks it. */
  .rail-email {
    color: var(--color-ink-dim);
    padding-inline: 24px;
    appearance: none;
    background: none;
    border: 0;
    font-family: inherit;
    font-weight: inherit;
    letter-spacing: inherit;
    cursor: pointer;
  }

  /* While the "Copied" flash is up the cell goes full ink — the one moment it
     is louder than the two nav links beside it. Hover and focus are excluded
     BY HAND: the invert below is a plain `.rail-cell:hover`, which this
     attribute selector would otherwise outrank, painting ink on ink for the
     whole 1.6s — and you have to be hovering to have clicked. */
  .rail-email[data-copied]:not(:hover):not(:focus-visible) {
    color: var(--color-ink);
  }

  /* Hidden on phones; the spacer wakes up at 640, the email at 1024. */
  .rail-email,
  .rail-spacer {
    display: none;
  }

  /* ── The CTA ──────────────────────────────────────────────────────
     A faint accent tint, ink text, an accent underline, and a 1px `line`
     border at rail weight, pulled 1px proud top and bottom so the border lands
     exactly on the rail's hairlines rather than beside them. On phones it
     shares tier one with the wordmark and its right border sits on the
     viewport edge. */
  .rail-cta {
    order: 1;
    flex: 0 0 auto;
    background-color: color-mix(in srgb, var(--color-accent) 16%, var(--color-ground));
    color: var(--color-ink);
    border: 1px solid var(--color-line);
    box-shadow: inset 0 -4px 0 var(--color-accent);
    margin-block: -1px;
    padding-inline: 16px;
    gap: 12px;
  }

  .rail-cta-mark {
    display: grid;
    place-items: center;
    width: 22px;
    height: 22px;
    border-left: 1px solid color-mix(in srgb, var(--color-ink) 30%, transparent);
    padding-left: 10px;
    font-family: var(--font-mono);
    font-size: var(--text-label);
    line-height: 1;
  }

  /* Invert: ink ground, page-colour text. The rules stay put. */
  .rail-cell:hover,
  .rail-cell:focus-visible {
    background-color: var(--color-ink);
    color: var(--color-ground);
  }

  .rail-cta:hover,
  .rail-cta:focus-visible {
    box-shadow: inset 0 -4px 0 var(--color-accent);
  }

  .rail-cta:hover .rail-cta-mark,
  .rail-cta:focus-visible .rail-cta-mark {
    border-left-color: color-mix(in srgb, var(--color-ground) 45%, transparent);
  }

  /* The global focus ring is ink, which vanishes against the inverted ink
     cell — same square 2px ring, recoloured and pulled inside so it also
     clears the viewport edge on the CTA. */
  .rail-cell:focus-visible {
    outline: 2px solid var(--color-ground);
    outline-offset: -6px;
  }

  /* ── Tablet: one 56px row, email swapped for an empty spacer cell ── */
  @media (min-width: 640px) {
    .rail {
      flex-wrap: nowrap;
      height: 56px;
    }
    /* auto = stretch again, so all three fill the single row */
    .rail-mark,
    .rail-nav,
    .rail-cta {
      height: auto;
    }
    .rail-mark {
      flex: 0 0 auto;
      padding-inline: 30px;
    }
    .rail-nav {
      flex: 1 1 auto;
      order: 0;
      border-top: 0;
    }
    .rail-nav > * {
      flex: 0 0 auto;
    }
    .rail-nav > *:first-child {
      border-left: 1px solid var(--color-line);
    }
    .rail-link {
      padding-inline: 16px;
    }
    .rail-cta {
      order: 0;
      padding-inline: 16px;
    }
    .rail-nav > .rail-spacer {
      display: block;
      flex: 1 1 0;
    }
  }

  /* ── Desktop: the email takes the middle back off the spacer ── */
  @media (min-width: 1024px) {
    .rail-nav > .rail-spacer {
      display: none;
    }
    .rail-nav > .rail-email {
      display: flex;
      flex: 1 1 0;
    }
  }

  /* PhotoTransition drops its named elements under reduced motion; so does the rail. */
  @media (prefers-reduced-motion: reduce) {
    .rail {
      view-transition-name: none;
    }
  }
</style>

<style is:global>
  /* The rail is its own view-transition group, so on /ugc <-> /creative-tech it
     is lifted out of the page's cross-fade. Both snapshots are the same pixels
     in the same place, so the default cross-fade between them reads as
     stillness; only the aria-current underline moves. Painted above the photo
     morph (z-index 2/3 in PhotoTransition), as the live sticky rail is.
     To and from the cover there is no counterpart, so the rail leaves and
     arrives on the page's own timings (PhotoTransition: out 140ms, in 260ms
     after 100ms) instead of the UA default. */
  ::view-transition-group(site-rail) { z-index: 4; }
  ::view-transition-old(site-rail):only-child { animation: rail-out 140ms ease both; }
  ::view-transition-new(site-rail):only-child { animation: rail-in 260ms 100ms ease both; }
  @keyframes rail-out { to { opacity: 0; } }
  @keyframes rail-in { from { opacity: 0; } to { opacity: 1; } }

  /* The film grain (body::after in global.css, fixed, multiply) normally lands
     in the ROOT snapshot, which sits UNDER every named group. A rail lifted out
     of root would therefore lose its grain for the length of the transition:
     measured +10 levels of brightness (221.6 -> 231.8 mean RGB) for ~360ms,
     which reads as a flash. So on pages that have the rail, the grain is a
     group of its own above everything, where it is on the live page. Its
     multiply blend is carried by the group. Between the two portfolios it does
     not animate at all; to and from the cover (whose grain stays in root) it
     keeps the page's fade timings. */
  body::after { view-transition-name: film-grain; }
  ::view-transition-group(film-grain) { z-index: 10; animation: none; }
  ::view-transition-old(film-grain) { display: none; }
  ::view-transition-new(film-grain) { animation: none; }
  ::view-transition-old(film-grain):only-child { display: block; animation: rail-out 140ms ease both; }
  ::view-transition-new(film-grain):only-child { animation: rail-in 260ms 100ms ease both; }
  @media (prefers-reduced-motion: reduce) {
    body::after { view-transition-name: none; }
  }
</style>

<script>
  import { onPageReady } from '../scripts/page-ready';
  onPageReady(() => {
  // Progressive enhancement, deliberately JS-only: with scripts off the cell is
  // still the address, legible and selectable, which is what people do by hand
  // anyway. Nothing else on the rail depends on this running.
  document.querySelectorAll<HTMLButtonElement>("[data-copy-email]").forEach((button) => {
    const address = button.dataset.copyEmail ?? "";
    const label = button.querySelector<HTMLElement>("[data-copy-label]");
    const status = button.querySelector<HTMLElement>("[data-copy-status]");
    if (!address || !label || !status) return;

    let timer: number | undefined;

    async function write(text: string) {
      if (window.isSecureContext && navigator.clipboard) {
        try {
          await navigator.clipboard.writeText(text);
          return true;
        } catch {
          // Denied or unavailable — drop through to the legacy path.
        }
      }
      const scratch = document.createElement("textarea");
      scratch.value = text;
      scratch.setAttribute("readonly", "");
      scratch.style.cssText = "position:fixed;top:-9999px;opacity:0";
      document.body.append(scratch);
      scratch.select();
      let ok = false;
      try {
        ok = document.execCommand("copy");
      } catch {
        ok = false;
      }
      scratch.remove();
      return ok;
    }

    button.addEventListener("click", async () => {
      const ok = await write(address);
      window.clearTimeout(timer);

      // Sighted feedback is the label swap; the live region is the same news
      // for a screen reader, which would not otherwise hear the button's own
      // content change.
      label.textContent = ok ? "Copied" : "Copy failed";
      status.textContent = ok ? `Copied ${address}` : `Could not copy. The address is ${address}`;
      button.toggleAttribute("data-copied", ok);

      timer = window.setTimeout(() => {
        label.textContent = address;
        status.textContent = "";
        button.removeAttribute("data-copied");
      }, 1600);
    });
  });
  });
</script>
