---
/**
 * Hero media slot — the crop Dom set in the tuner (3012x2133 of the source). It fills its parent and is cropped by
 * object-cover, so the parent owns the size, the position and the mask that
 * dissolves the left edge into the ground (see Hero.astro).
 *
 * Image first: the poster is the LCP element, so it is never lazy and carries
 * fetchpriority="high". When `video` is set, a muted looping clip layers over
 * the poster and the poster stays as its fallback frame.
 *
 * `poster` is the .jpg path; the -1000 variant and the .webp siblings are
 * derived from it, so all four files must be generated together
 * (see PROGRESS.md for the crop recipe).
 */
interface Props {
  poster: string;
  alt: string;
  video?: string | null;
}
const { poster, alt, video = null } = Astro.props;
const base = poster.replace(/\.jpg$/, "");
const srcset = (ext: string) => `${base}-1000.${ext} 1000w, ${base}.${ext} 2000w`;
// Desktop the photo is 69vw; on phones it is the full column width.
const sizes = "(min-width: 1024px) 69vw, 100vw";
---

<picture>
  <source type="image/webp" srcset={srcset("webp")} sizes={sizes} />
  <img
    src={poster}
    srcset={srcset("jpg")}
    sizes={sizes}
    alt={alt}
    width="2000"
    height="1416"
    fetchpriority="high"
    decoding="async"
  />
</picture>
{video && (
  <video
    src={video}
    poster={poster}
    autoplay
    muted
    playsinline
    loop
    preload="metadata"
    aria-hidden="true"
    class="motion-reduce:hidden"
  ></video>
)}
