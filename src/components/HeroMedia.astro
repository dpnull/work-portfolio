---
/**
 * Hero media slot — SQUARE (1:1). Image first: the poster is the LCP element
 * and always renders. When `video` is set, a muted looping clip layers over
 * the poster and the poster stays as its fallback frame. Never lazy — this is
 * above the fold. NOTE: a 9:16 clip dropped in here is centre-cropped to the
 * square by object-cover.
 */
interface Props {
  poster: string;
  alt: string;
  video?: string | null;
}
const { poster, alt, video = null } = Astro.props;
---

<figure class="bg-surface relative aspect-square w-full overflow-hidden rounded-(--radius-tile)">
  <img
    src={poster}
    alt={alt}
    width="1080"
    height="1080"
    fetchpriority="high"
    decoding="async"
    class="absolute inset-0 h-full w-full object-cover"
  />
  {video && (
    <video
      src={video}
      poster={poster}
      autoplay
      muted
      playsinline
      loop
      preload="metadata"
      aria-hidden="true"
      class="absolute inset-0 h-full w-full object-cover motion-reduce:hidden"
    ></video>
  )}
</figure>
