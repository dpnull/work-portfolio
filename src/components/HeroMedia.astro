---
/**
 * Hero media slot — two art-directed crops of the same photograph. It fills its
 * parent and is cropped by object-cover, so the parent owns the size, the
 * position and the mask that dissolves an edge into the ground (see Hero.astro).
 *
 *   >= 768px   the LANDSCAPE crop (3012x2133 of the source, the tuner's frame),
 *              pinned right and dissolved on its left. Tablets joined this set
 *              on 2026-09-07, when the overlap composition was extended down
 *              from 1024 to 768 — a portrait column in an overlap layout would
 *              be cropped to a sliver.
 *   <  768px   a PORTRAIT 3:4 crop (1848x2464 of the source), served 1200w +
 *              800w. Band D crops it to a CONSTANT box aspect — square on a
 *              phone, 6:5 from 600 to 767 — so object-cover takes the same
 *              slice at every width in each band and his head holds the same
 *              fraction of the box. Re-cutting this asset to a different aspect
 *              means re-deriving both `--m-aspect` values and the
 *              object-position that goes with them, in the same commit.
 *
 * The portrait entries carry `media="(max-width: 767px)"`, so a desktop
 * browser never downloads them and a phone never downloads the landscape set.
 *
 * Image first: the poster is the LCP element, so it is never lazy and carries
 * fetchpriority="high". When `video` is set, a muted looping clip layers over
 * the poster and the poster stays as its fallback frame.
 *
 * `poster` is the landscape .jpg path; every sibling is derived from it — the
 * -1000 variant, the .webp twins and the `-m` portrait set — so all of them
 * must be generated together (crop recipes are in PROGRESS.md).
 */
interface Props {
  poster: string;
  alt: string;
  video?: string | null;
}
const { poster, alt, video = null } = Astro.props;
const base = poster.replace(/\.jpg$/, "");

// Landscape (tablet + desktop): 2000w + 1000w. The photo is 69vw from 768 up.
const srcset = (ext: string) => `${base}-1000.${ext} 1000w, ${base}.${ext} 2000w`;
const sizes = "(min-width: 768px) 69vw, 100vw";

// Portrait (small tablet + phone): 1200w + 800w. A 46vw column on small
// tablets, the full viewport width on phones. 600px is band C's start.
const mSrcset = (ext: string) => `${base}-m-800.${ext} 800w, ${base}-m.${ext} 1200w`;
const mSizes = "(min-width: 600px) 46vw, 100vw";
---

<picture>
  <source media="(max-width: 767px)" type="image/webp" srcset={mSrcset("webp")} sizes={mSizes} />
  <source media="(max-width: 767px)" type="image/jpeg" srcset={mSrcset("jpg")} sizes={mSizes} />
  <source type="image/webp" srcset={srcset("webp")} sizes={sizes} />
  <img
    src={poster}
    srcset={srcset("jpg")}
    sizes={sizes}
    alt={alt}
    width="2000"
    height="1416"
    fetchpriority="high"
    decoding="async"
  />
</picture>
{video && (
  <video
    src={video}
    poster={poster}
    autoplay
    muted
    playsinline
    loop
    preload="metadata"
    aria-hidden="true"
    class="motion-reduce:hidden"
  ></video>
)}
