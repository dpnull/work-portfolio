---
import site from "../data/site.json";

/**
 * SOCIAL RAIL — four cells stacked down the hero photo's top-right sky (Dom,
 * 2026-09-08: Instagram, RedNote, LinkedIn, email, in that order, VERTICAL).
 *
 * WHY IT LOOKS LIKE THIS. Two objects on the page already say "cell": the header
 * rail (fused hairline cells, instant invert on hover) and the lede's white
 * plates. This is both of them at once — a short row of plate-white cells fused
 * by a single shared hairline, ink glyphs, no radius, no transition. Nothing new
 * is invented for it, which is why it can sit on the photograph without reading
 * as a widget someone bolted on.
 *
 * WHY IT IS ABSOLUTE INSIDE .hero AND NOT INSIDE .wrap. In band D (phones) the
 * photo is a full-bleed block that comes BEFORE .wrap in the flow, so anything
 * positioned against .wrap lands under the picture rather than on it. Against
 * .hero the row is at the photo's top-right corner in all four bands.
 *
 * CONTRAST is not a question here: the cell carries its own plate, so the glyph
 * is ink on white (18.2:1) wherever the sky happens to be light or dark.
 *
 * THE EMAIL CELL COPIES, it does not open a mail client — the same call Dom made
 * for the header's email cell on 2026-09-07 ("a mail client firing off unasked is
 * a worse outcome than a copied string"). The clipboard logic below is a
 * deliberate second copy of the header's, not a reuse of it: the header cell
 * reports by SWAPPING ITS OWN LABEL, and a 40px square has no label to swap, so
 * this one reports with a chip under the cell instead — and it has to be able to
 * say "Copy failed" as well as "Copied", which the header's attribute alone
 * cannot express. Hence a different hook (`data-copy-address`, not
 * `data-copy-email`): sharing the attribute would have both scripts binding both
 * cells. If the two ever have to converge, lift `write()` into a shared module
 * and leave the reporting in each component.
 *
 * PENDING LINKS. A cell whose href is empty renders as an inert span, not a
 * link — the icons Dom asked for are all present and none of them is a guessed
 * URL. RedNote and LinkedIn are waiting on the real profile addresses (there is
 * no copy of either anywhere in Notion; Instagram's came from the Site page).
 *
 * RedNote has no monochrome mark of its own — the brand is a red tile with
 * 小红书 set in white — so its cell is a RED letterform in Kode Mono, sized to
 * the same optical weight as the three glyphs beside it.
 */

interface Props { inline?: boolean; horizontal?: boolean; }
const { inline = false, horizontal = false } = Astro.props;
const cells = site.social ?? [];
---

<nav class:list={["social", { "social-inline": inline, "social-horizontal": horizontal }]} aria-label="Social profiles">
  <ul class="social-row" role="list">
    {
      cells.map((cell) => {
        const glyph = (
          <svg class="social-icon" viewBox="0 0 24 24" aria-hidden="true">
            {cell.id === "instagram" && (
              <>
                <rect x="3" y="3" width="18" height="18" rx="5" />
                <circle cx="12" cy="12" r="4.1" />
                <circle class="social-dot" cx="17.2" cy="6.8" r="1.05" />
              </>
            )}
            {cell.id === "linkedin" && (
              <>
                <path d="M15.5 9.2a5.3 5.3 0 0 1 5.3 5.3V21h-3.6v-6.5a1.7 1.7 0 0 0-3.4 0V21h-3.6V9.6h3.6v1.3a5.2 5.2 0 0 1 1.7-1.7z" />
                <rect x="3.2" y="9.6" width="3.6" height="11.4" />
                <circle cx="5" cy="4.7" r="1.8" />
              </>
            )}
            {cell.id === "email" && (
              <>
                <rect x="2.6" y="5" width="18.8" height="14" rx="2.2" />
                <path d="M3.2 7.1 12 13.2l8.8-6.1" />
              </>
            )}
          </svg>
        );

        const inner =
          cell.id === "rednote" ? (
            <span class="social-red" aria-hidden="true">RED</span>
          ) : (
            glyph
          );

        if (cell.id === "email") {
          return (
            <li>
              <button
                type="button"
                class="social-cell"
                data-copy-address={site.email}
                aria-label={`Copy email address ${site.email}`}
                title="Click to copy"
              >
                {inner}
                <span class="sr-only" role="status" aria-live="polite" data-copy-status></span>
              </button>
            </li>
          );
        }

        if (!cell.href) {
          return (
            <li>
              <span class="social-cell" data-pending title={`${cell.label} — link to come`}>
                {inner}
                <span class="sr-only">{cell.label}</span>
              </span>
            </li>
          );
        }

        return (
          <li>
            <a
              class="social-cell"
              href={cell.href}
              target="_blank"
              rel="me noopener"
              aria-label={`${cell.label}${cell.handle ? ` — ${cell.handle}` : ''}${cell.followers ? ` · ${cell.followers} followers` : ''}`}
              title={cell.handle || cell.label}
            >
              {inner}
              {cell.followers && <span class="follower-count">{cell.followers}</span>}
            </a>
          </li>
        );
      })
    }
  </ul>
</nav>

<style>
  /* Top-right of the photograph in every band. The insets are the page's own
     gutters (px-6 / px-8), so the row hangs off the same edge the copy below it
     is measured from. z-index 3 clears the veil (1) and the copy column (2). */
  .social {
    position: absolute;
    top: 1.25rem;
    right: 1.5rem;
    z-index: 3;
  }

  /* A COLUMN, not a row (Dom, 2026-09-08 — it was horizontal for one pass).
     Same construction either way: one object, neighbours sharing a single
     hairline (the header rail's rule), plate unbroken behind all four. Vertical
     also keeps the block off the header's own cells, which a horizontal row sat
     directly under and read as a second tier of. */
  .social-row {
    display: flex;
    flex-direction: column;
    background-color: var(--color-plate);
  }

  .social-cell {
    position: relative; /* the "Copied" chip hangs off this */
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    color: var(--color-ink);
    /* The email cell is a <button>; strip the UA chrome so all four match. */
    appearance: none;
    background: none;
    border: 0;
    padding: 0;
    font-family: inherit;
    cursor: pointer;
  }

  .social-row > li + li .social-cell {
    border-top: 1px solid var(--color-line);
  }

  .social-icon {
    width: 19px;
    height: 19px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  /* Instagram's flash dot is solid — an outlined 1px circle at this size is mush. */
  .social-dot {
    fill: currentColor;
    stroke: none;
  }

  /* RedNote's stand-in letterform. Kode Mono is the site's label face; the size
     and tracking are set so the three letters carry the same weight as a 19px
     stroked glyph rather than shouting next to them. */
  .social-red {
    font-family: var(--font-mono, "Kode Mono", monospace);
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.02em;
    line-height: 1;
  }

  /* Instant invert, no transition — the header rail's behaviour. */
  .social-cell:hover,
  .social-cell:focus-visible {
    background-color: var(--color-ink);
    color: var(--color-plate);
  }

  /* Ink-on-ink would swallow the global ring, same as the header's cells. */
  .social-cell:focus-visible {
    outline: 2px solid var(--color-plate);
    outline-offset: -5px;
  }

  /* No href yet: present, legible, and deliberately not pretending to be a
     link — no pointer, no invert, the glyph one step back in the ink scale. */
  .social-cell[data-pending] {
    color: var(--color-ink-dim);
    cursor: default;
  }
  .social-cell[data-pending]:hover {
    background-color: transparent;
    color: var(--color-ink-dim);
  }

  /* The email cell's only visible feedback (the label swap the header cell uses
     has nowhere to go in a 40px square). It sits to the LEFT of the cell, not
     under it: in a column the space below the last cell is the photograph's
     bright horizon, and the chip has to stay inside the frame at every width —
     growing inwards over the picture always has room. Both outcomes speak: a
     copy that silently fails on an http host would otherwise look like a dead
     button. */
  .social-cell[data-copy-state="ok"]::after {
    content: "Copied";
  }
  .social-cell[data-copy-state="fail"]::after {
    content: "Copy failed";
  }
  .social-cell[data-copy-state]::after {
    position: absolute;
    top: 50%;
    right: calc(100% + 6px);
    transform: translateY(-50%);
    padding: 3px 7px;
    background-color: var(--color-ink);
    color: var(--color-plate);
    font-family: var(--font-mono, "Kode Mono", monospace);
    font-size: 0.625rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  @media (min-width: 40rem) {
    .social {
      top: 1.5rem;
      right: 2rem;
    }
    .social-cell {
      width: 44px;
      height: 44px;
    }
  }
  .social-inline { position: static; margin-top: 16px; width: fit-content; }
  .social-inline .social-row { flex-direction: row; background: transparent; border: 1px solid var(--color-line); }
  .social-inline .social-cell { width: 44px; height: 44px; }
  .social-inline .social-cell:has(.follower-count) {height:62px;flex-direction:column;gap:5px}
  .follower-count {font-size:10px;font-weight:650;line-height:1;letter-spacing:-.02em}
  @media(max-width:650px){.social-inline .social-cell{height:62px;width:52px}}
  .social-inline .social-row > li + li .social-cell { border-top: 0; border-left: 1px solid var(--color-line); }
  .social-inline .social-cell[data-copy-state]::after { top: calc(100% + 8px); right: 0; transform: none; }
  @media (min-width: 651px) {
    .social-inline:not(.social-horizontal) { position: absolute; top: auto; right: calc(100% + 16px); bottom: 32px; margin-top: 0; }
    .social-inline:not(.social-horizontal) .social-row { flex-direction: column; }
    .social-inline:not(.social-horizontal) .social-row > li + li .social-cell { border-left: 0; border-top: 1px solid var(--color-line); }
  }
  .social-horizontal{margin-top:28px}
  .social-horizontal .social-cell{width:62px;height:62px}
</style>

<script>
  // Progressive enhancement, JS-only on purpose: with scripts off the cell is
  // still a labelled button and the address is in its accessible name. The two
  // paths mirror Header.astro's — the modern API where the page is a secure
  // context, execCommand where it is not (an http staging host).
  document.querySelectorAll<HTMLButtonElement>("[data-copy-address]").forEach((button) => {
    const address = button.dataset.copyAddress ?? "";
    const status = button.querySelector<HTMLElement>("[data-copy-status]");
    if (!address || !status) return;

    let timer: number | undefined;

    async function write(text: string) {
      if (window.isSecureContext && navigator.clipboard) {
        try {
          await navigator.clipboard.writeText(text);
          return true;
        } catch {
          // Denied or unavailable — drop through to the legacy path.
        }
      }
      const scratch = document.createElement("textarea");
      scratch.value = text;
      scratch.setAttribute("readonly", "");
      scratch.style.cssText = "position:fixed;top:-9999px;opacity:0";
      document.body.append(scratch);
      scratch.select();
      let ok = false;
      try {
        ok = document.execCommand("copy");
      } catch {
        ok = false;
      }
      scratch.remove();
      return ok;
    }

    button.addEventListener("click", async () => {
      const ok = await write(address);
      window.clearTimeout(timer);

      // The chip is the sighted feedback; the live region is the same news for
      // a screen reader, which cannot see a ::after.
      button.dataset.copyState = ok ? "ok" : "fail";
      status.textContent = ok ? `Copied ${address}` : `Could not copy. The address is ${address}`;

      timer = window.setTimeout(() => {
        delete button.dataset.copyState;
        status.textContent = "";
      }, 1600);
    });
  });
</script>
