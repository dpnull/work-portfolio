---
import site from "../data/site.json";
---
<footer id="contact" class="footer">
  <div class="footer-top">
    <span>&copy; {new Date().getFullYear()} {site.name}</span>
    <a href={`mailto:${site.email}`}>{site.email}</a>
    <nav aria-label="Social profiles">
      {site.social.filter(profile => profile.id !== "email" && profile.href).map(profile => (
        <a href={profile.href} target="_blank" rel="noopener noreferrer">{profile.label}</a>
      ))}
    </nav>
  </div>
</footer>
<style>
  .footer{max-width:var(--container-page);margin:auto;padding:28px 32px;border-top:1px solid var(--color-line);font-size:14px;scroll-margin-top:100px}
  .footer-top,nav{display:flex;flex-wrap:wrap;align-items:center;gap:20px}
  .footer-top{justify-content:space-between}nav{gap:24px}
  a{overflow-wrap:anywhere;text-underline-offset:4px}a:hover{text-decoration:underline}
  @media(max-width:639px){.footer{padding:24px}.footer-top{align-items:flex-start;flex-direction:column}}
</style>
