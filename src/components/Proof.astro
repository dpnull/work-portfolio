---
import site from "../data/site.json";
---
<section class="proof" aria-label="Audience result">
  <p><strong>{site.hero.proof.value}</strong> {site.hero.proof.label}</p>
  <p>{site.hero.proof.context}</p>
</section>
<style>
  .proof { display: flex; justify-content: space-between; align-items: center; gap: 16px; padding: 20px 5%; border-block: 1px solid var(--color-line); font-size: 14px; }
  p { margin: 0; }
  strong { font-size: clamp(22px, 2cqw, 32px); font-weight: 600; letter-spacing: -.04em; margin-right: 10px; }
  @media (max-width: 650px) { .proof { align-items: flex-start; flex-direction: column; gap: 8px; padding: 18px 6%; font-size: 13px; } }
</style>
