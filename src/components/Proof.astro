---
import site from "../data/site.json";
---
<section class="proof" aria-label="Audience result">
  <p class="proof-line">
    <span class="proof-comparison">
    <span class="proof-metric"><strong class="proof-value">{site.hero.proof.followers}</strong> <span class="proof-label">followers</span></span>
    <span class="proof-equals">=</span>
    <span class="proof-metric"><strong class="proof-value">{site.hero.proof.value}</strong> <span class="proof-label">{site.hero.proof.label}</span></span>
    </span>
    <span class="proof-rule" aria-hidden="true"></span>
    <span class="proof-context">{site.hero.proof.context}</span>
  </p>
</section>
<style>
  .proof { display: grid; place-items: center; padding: 22px 5%; border-block: 1px solid var(--color-line); }
  .proof-line { display: flex; align-items: baseline; justify-content: center; gap: 10px; margin: 0; }
  .proof-value { font-size: clamp(24px, 2.4vw, 34px); font-weight: 650; line-height: 1; letter-spacing: -.045em; }
  .proof-label { font-size: 16px; font-weight: 600; }
  .proof-rule { align-self: stretch; width: 1px; min-height: 26px; margin-inline: 8px; background: var(--color-line); }
  .proof-context { color: var(--color-ink); font-size: 16px; font-weight: 600; }
  .proof-line { text-align: center; }
  .proof-metric { display: inline-flex; align-items: baseline; gap: 8px; }
  .proof-equals { font-size: 22px; font-weight: 600; }
  .proof-context { max-width: 38ch; }
  .proof-rule { align-self: center; height: 32px; min-height: 0; flex-shrink: 0; }
  .proof-line {display:grid;grid-template-columns:minmax(0,1fr) 1px minmax(0,1fr);width:100%;max-width:1100px;gap:32px;align-items:center}
  .proof-comparison{display:flex;align-items:baseline;justify-content:center;gap:10px;flex-wrap:wrap}
  .proof-rule{margin:0}
  .proof-context{justify-self:center}
  @media (max-width: 1000px) {
    .proof-line { display:flex;flex-direction:column;gap:8px; }
    .proof-context { flex-basis: 100%; max-width: none; margin-top: 8px; }
    .proof-rule { display: none; }
  }
  @media (max-width: 650px) {
    .proof { padding: 20px 6%; }
    .proof-line { flex-wrap: wrap; gap: 4px 8px; max-width: 24rem; }
    .proof-label { font-size: 15px; }
    .proof-rule { display: none; }
    .proof-context { flex-basis: 100%; font-size: 15px; }
  }
</style>
