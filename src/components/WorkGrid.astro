---
/**
 * Grid shell for block 2. Four tiles for now; block 2 swaps the posters for
 * Mux tiles and wires the IntersectionObserver. 2-across on phones, 4 on desktop.
 */
import clips from "../data/clips.json";
const TILE_COUNT = 4;
const tiles = clips.groups.flatMap((g) => g.clips).slice(0, TILE_COUNT);
---

<section id="work" aria-labelledby="work-heading" class="mx-auto max-w-(--container-page) px-6 py-16 sm:px-8">
  <h2 id="work-heading" class="font-display text-section">Work</h2>

  <ul class="mt-8 grid grid-cols-2 gap-4 lg:grid-cols-4 lg:gap-6" role="list">
    {tiles.map((clip) => (
      <li>
        <div class="bg-surface border-line aspect-[9/16] rounded-(--radius-tile) border border-dashed"></div>
        <p class="mt-3 text-sm">{clip.title}</p>
        <p class="text-ink-dim font-mono text-xs">
          {[clip.label.format, clip.label.category, clip.label.result].filter(Boolean).join(" · ") || "format · category · result"}
        </p>
      </li>
    ))}
  </ul>
</section>
