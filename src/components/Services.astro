---
import offers from "../data/offers.json";
interface Props { kind?: "ads" | "systems" }
const { kind = "ads" } = Astro.props;
const packages = kind === "ads"
  ? [offers.ad, { ...offers.monthly, title: "Retainer", description: "A month of content shaped and funneled around your ideal audience.", note: "I use my own audience data to shape content around your ideal customer and refine what turns their interest into action." }]
  : [offers.monthly, offers.founder];
---
<section id="work-with-me" aria-labelledby="services-heading">
  <h2 id="services-heading" class="font-display text-section">{kind === "ads" ? "Work with me" : "Monthly retainers"}</h2>
  <div class="offers">
    {packages.map((offer, index) => (
      <article>
        <h3>{offer.title}</h3>
        <p class="price">From {offer.price} {offer.period && <span>{offer.period}</span>}</p>
        <p>{offer.description}</p>
        <p class="note">{offer.note}{kind === "ads" && index === 1 && <> <a href="/content-systems">Explore content systems →</a></>}</p>
      </article>
    ))}
  </div>
</section>
<style>
  section{padding-top:48px;scroll-margin-top:90px}
  h2{margin:0 0 32px}
  .offers{display:grid;grid-template-columns:1fr 1fr;column-gap:32px;border-top:1px solid var(--color-line)}
  article{padding:28px 0}
  h3{font-size:var(--text-subheading);font-weight:600;margin:0 0 12px;letter-spacing:-.02em}
  p{font-size:var(--text-body);line-height:1.5;max-width:45ch;margin:0 0 14px}
  .price{font-size:var(--text-subheading);font-weight:600;letter-spacing:-.025em;margin-bottom:20px}
  .price span{font-size:var(--text-caption);font-weight:400;letter-spacing:0}
  .note{font-size:var(--text-caption);color:var(--color-ink-dim);margin-bottom:0}
  .note a{text-decoration:underline;text-underline-offset:3px}
  @media(max-width:650px){.offers{grid-template-columns:1fr}article{padding:24px 0}}
</style>
