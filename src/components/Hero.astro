---
import site from "../data/site.json";
import HeroMedia from "./HeroMedia.astro";
const { hero } = site;
---

<section
  aria-labelledby="hero-heading"
  class="mx-auto grid max-w-(--container-page) items-center gap-10 px-6 py-10 sm:px-8 lg:grid-cols-12 lg:gap-20 lg:py-16"
>
  <!-- Copy first in the DOM so the phone shows the summary before the media. -->
  <div class="lg:order-2 lg:col-span-7">
    {/* No visible title by Dom's call; the page still needs one h1 for structure. */}
    <h1 id="hero-heading" class="sr-only">{hero.srHeading}</h1>

    <p class="text-lede max-w-[46ch] text-pretty">{hero.summary}</p>
  </div>

  <!-- Square frame: capping the width caps the height too, so the stats stay in reach on phones. -->
  <div class="mx-auto w-full max-w-[min(100%,60svh)] lg:order-1 lg:col-span-5 lg:max-w-none">
    <HeroMedia poster={hero.poster} alt={hero.posterAlt} video={hero.video} />
  </div>
</section>
