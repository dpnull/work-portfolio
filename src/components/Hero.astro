---
import site from "../data/site.json";
import HeroMedia from "./HeroMedia.astro";
const { hero } = site;

/**
 * Hero — four responsive bands. Read the band you are touching; they are
 * deliberately independent, because the composition changes, not just the size.
 *
 *   A  >= 1280px   copy left, photo pinned right and dissolved into the ground
 *                  on its left. DOM'S TUNED VALUES — do not alter (see below).
 *   B  1024-1279   same composition, made to scale: height derived from the
 *                  photo's aspect, copy column tied to the viewport, and the
 *                  photo anchored to its own left edge so the dissolve zone
 *                  shows the same sky at every width.
 *   C  768-1023    two columns, no overlap: copy left, a portrait photo flush
 *                  to the right edge with a short feathered left edge.
 *   D  < 768px     the photo as a full-bleed 3:4 block with the lede lifted ON
 *                  to its bottom-left, the way the desktop lede sits on the
 *                  faded part of the picture. Blocks + tools stay on the ground
 *                  below it.
 *
 * Band A's numbers came out of the hero tuner (scratchpad/hero-tuner.html,
 * published as an Artifact); Dom dialled them on 2026-09-07. Don't eyeball
 * changes to them — re-open the tuner, move the sliders, and paste the
 * settings block back.
 *
 *   photo width 69%   crop x=0 y=915 w=3012 h=2133 of the 3024x4537 source
 *   dissolve  floor 48%, feather 6%, solid at 22%, eased
 *   veil      95%, gone by 62%, starts 48% down
 *
 * The floor is the point: the photo keeps 48% opacity all the way to its left
 * edge instead of fading to nothing, so it reads as one image washing into the
 * page rather than a picture with a soft border. The 6% feather is what stops
 * that left edge being a visible line.
 *
 * The lede's measure (33ch) breaks the sentence over FOUR lines, which is what
 * carries it into the picture. The four-line band is ~29ch-34ch. If the
 * sentence is rewritten, re-check the line count in every band.
 *
 * Below 1024px the composition changes rather than shrinking: the photo becomes
 * a column (C) or a full-bleed block (D), and the media slot switches to a 3:4
 * portrait crop cut for those boxes.
 *
 * Band D's rule, and the reason its numbers look fussy: THE BOX HEIGHT COMES
 * FROM THE WIDTH ALONE. A `max-height` cap in portrait would change the box
 * aspect as the viewport got narrower or shorter, object-cover would re-crop,
 * and his head would slide around — which is exactly what Dom saw with the old
 * 55svh cap. `aspect-ratio: 3 / 4` on an asset that is itself exactly 3:4 means
 * cover has nothing to crop at any phone size, so the face sits at the same
 * fraction of the box everywhere and the caption can be guaranteed clear of it
 * by arithmetic instead of by eye. The only cap left is the landscape guard,
 * and there the lede drops back below the photo rather than sitting on it.
 */
---

<section aria-labelledby="hero-heading" class="hero">
  <div class="media">
    <HeroMedia poster={hero.poster} alt={hero.posterAlt} video={hero.video} />
  </div>
  <div class="veil" aria-hidden="true"></div>

  <div class="wrap mx-auto max-w-(--container-page) px-6 py-10 sm:px-8 lg:py-16">
    {/* No visible title by Dom's call; the page still needs one h1 for structure. */}
    <h1 id="hero-heading" class="sr-only">{hero.srHeading}</h1>

    <p class="lede text-pretty"><span>{hero.lede}</span></p>

    <div class="hero-blocks border-line mt-7 grid gap-5 border-t pt-5">
      {hero.blocks.map((block) => (
        <div>
          <p class="hero-label text-ink-dim mb-1 text-xs font-semibold tracking-[0.11em] uppercase">
            {block.label}
          </p>
          <p>{block.body}</p>
        </div>
      ))}
    </div>

    {/* Full-strength ink, not ink-dim: in bands A and B the tail of this line
        sits over the darkest part of the photo, where dim grey measured 2.6:1. */}
    <p class="hero-tools mt-5 text-[0.8125rem]">{hero.tools}</p>
  </div>
</section>

<style>
  .hero {
    position: relative;
    isolation: isolate;

    /* ── Band D dials (phone). Every one of these is in the phone tuner
       (scratchpad/phone-tuner.html); move them there, not here. ────────── */
    --m-aspect: 3 / 4; /* photo box, and the asset's own aspect */
    --m-lede-size: clamp(1.0625rem, 5.334vw, 1.25rem);
    --m-lede-lines: 5; /* the lede's line count — see the note on the lift */
    --m-lede-inset: 20px; /* lede baseline block to the photo's bottom edge */
    --m-lede-measure: 26ch;
    --m-plate-gap: 4px;
    /* Bottom dissolve: full opacity to 54%, smootherstep down to a 44% FLOOR
       by 74%, that floor held to 96% (the whole caption zone sits on it), then
       a 4% feather to nothing so the photo's bottom edge is never a line.
       Stops are 6t^5-15t^4+10t^3 — never flatten this to two stops. */
    --m-fade: linear-gradient(
      to bottom,
      #000 54%,
      rgb(0 0 0 / 0.996) 55.82%,
      rgb(0 0 0 / 0.975) 57.64%,
      rgb(0 0 0 / 0.928) 59.45%,
      rgb(0 0 0 / 0.856) 61.27%,
      rgb(0 0 0 / 0.767) 63.09%,
      rgb(0 0 0 / 0.673) 64.91%,
      rgb(0 0 0 / 0.584) 66.73%,
      rgb(0 0 0 / 0.512) 68.55%,
      rgb(0 0 0 / 0.465) 70.36%,
      rgb(0 0 0 / 0.444) 72.18%,
      rgb(0 0 0 / 0.440) 74%,
      rgb(0 0 0 / 0.440) 96%,
      rgb(0 0 0 / 0.424) 96.67%,
      rgb(0 0 0 / 0.348) 97.33%,
      rgb(0 0 0 / 0.220) 98%,
      rgb(0 0 0 / 0.092) 98.67%,
      rgb(0 0 0 / 0.016) 99.33%,
      rgb(0 0 0 / 0.000) 100%
    );
  }
  .wrap {
    position: relative;
    z-index: 2;
  }
  .media {
    position: relative;
    z-index: 0;
  }
  /* <picture> is inline by default, so a percentage height on the img inside
     it resolves to auto and the photo collapses. It has to be a block box. */
  .media :global(picture) {
    display: block;
    height: 100%;
  }
  .media :global(img),
  .media :global(video) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .media :global(video) {
    position: absolute;
    inset: 0;
  }

  /* ── Band D — phone (< 768px) ────────────────────────────────────────────
     Full-bleed 3:4 block, the lede lifted on to its bottom-left, blocks and
     tools on the ground below. NO height cap in portrait: the box aspect is
     the asset's aspect, so object-cover never re-crops and the face holds the
     same fraction of the box at 320 and at 767 alike. */
  .media :global(img),
  .media :global(video) {
    aspect-ratio: var(--m-aspect);
    /* The box is exactly the asset's aspect here, so this is a no-op in
       portrait. It only bites under the landscape guard below. */
    object-position: 50% 50%;
    /* The floor is the point (see band A): the photo washes into the ground
       instead of fading out under the caption. Stops in --m-fade. */
    -webkit-mask-image: var(--m-fade);
    mask-image: var(--m-fade);
  }

  /* Ground-coloured veil over the bottom of the photo, mirroring band A's:
     it keeps the exposed sky and sand behind the lime plates calm so the
     plates read as the loudest thing in the lower third. */
  .media::after {
    content: "";
    position: absolute;
    inset: 0;
    pointer-events: none;
    background-image: linear-gradient(
      to bottom,
      color-mix(in srgb, var(--color-ground) 0%, transparent) 58%,
      color-mix(in srgb, var(--color-ground) 0.3%, transparent) 61.82%,
      color-mix(in srgb, var(--color-ground) 2.1%, transparent) 65.64%,
      color-mix(in srgb, var(--color-ground) 5.9%, transparent) 69.45%,
      color-mix(in srgb, var(--color-ground) 11.8%, transparent) 73.27%,
      color-mix(in srgb, var(--color-ground) 19.1%, transparent) 77.09%,
      color-mix(in srgb, var(--color-ground) 26.9%, transparent) 80.91%,
      color-mix(in srgb, var(--color-ground) 34.2%, transparent) 84.73%,
      color-mix(in srgb, var(--color-ground) 40.1%, transparent) 88.55%,
      color-mix(in srgb, var(--color-ground) 43.9%, transparent) 92.36%,
      color-mix(in srgb, var(--color-ground) 45.7%, transparent) 96.18%,
      color-mix(in srgb, var(--color-ground) 46.0%, transparent) 100%
    );
  }


  /* Flex, not block, purely so the lede's own margins cannot collapse into the
     blocks' `mt-7` — the lift below depends on both margins landing in full. */
  .wrap {
    display: flex;
    flex-direction: column;
  }

  /* THE LIFT. The lede stays where it belongs in the source (before the
     blocks); it is only moved visually. A negative top margin raises it by
     exactly `wrap padding-top + inset + its own height`, which puts its last
     line `--m-lede-inset` above the photo's bottom edge; the matching positive
     bottom margin gives the space back, so the blocks sit exactly where they
     would have without the lift. `1em` here is the lede's own size, so the
     arithmetic survives the clamp. If the copy is ever rewritten to a different
     line count, `--m-lede-lines` is the number to change. */
  .lede {
    font-size: var(--m-lede-size);
    font-weight: 500;
    max-width: var(--m-lede-measure);
    line-height: calc(1.12em + var(--m-plate-gap)); /* plate height + gap */
    margin-top: calc(-1 * var(--m-lede-lift));
    margin-bottom: 0;
    --m-lede-lift: calc(
      2.5rem + var(--m-lede-inset) + var(--m-lede-lines) *
        (1.12em + var(--m-plate-gap))
    );
  }
  /* The lift ends inside the photo, so the flow after the lede would too: this
     puts the blocks' rule a normal 2.5rem below the photo's bottom edge instead
     of leaving the hole the raw lift would leave. Overrides the `mt-7` in the
     markup, which bands C and A/B put back. */
  .hero-blocks {
    font-size: 0.9375rem;
    max-width: 46ch;
    margin-top: calc(var(--m-lede-inset) + 2.5rem);
  }

  /* This element is bands A and B's veil only. The photo darkens towards the
     bottom (his jacket), and that is exactly where the supporting copy sits
     there; the veil brings the ground back under the lower-left copy and is
     masked away above the lede, so the sentence keeps sitting on open sky.
     Band C puts no text over the photo and needs none. Band D has its own,
     on `.media::after`, because there the veil has to stop at the photo's
     bottom edge rather than covering the whole hero. */
  .veil {
    display: none;
  }

  /* ── Band C — tablet (768-1023px) ────────────────────────────────────────
     Two columns and no overlap: copy left, the portrait crop as a full-height
     column flush to the right viewport edge and to the top of the hero. Only a
     short feathered left edge — not the 48%-floor dissolve and no veil — so it
     reads as a column of photograph, not a wash. */
  /* Landscape phones join this band rather than getting their own layout. A
     3:4 block would be 889px tall at 667px wide, and capping it at 88svh
     squashes the box so far that the bottom dissolve lands across his face —
     there is no room under his chin for a wash. As a column the box is close
     to the asset's own shape again, and the lede sits beside the photo instead
     of on it, so nothing can collide. */
  @media (min-width: 48rem) and (max-width: 63.9375rem),
    (max-width: 47.9375rem) and (orientation: landscape) {
    .media {
      position: absolute;
      inset: 0 0 0 auto;
      width: 46%;
    }
    /* Band D's bottom veil and lede lift are phone-only. */
    .media::after {
      display: none;
    }
    .lede {
      margin-top: 0;
    }
    .media :global(img),
    .media :global(video) {
      aspect-ratio: auto;
      max-height: none;
      /* The column is far taller than 3:4, so cover is height-driven and this
         only chooses which slice of the width survives. 50% keeps him centred
         in the column with the lamp still in shot on his left. */
      object-position: 50% 50%;
      /* Smootherstep over the leftmost 9% of the photo, 0 -> 100%. A two-stop
         linear fade this short reads as a hard edge. */
      -webkit-mask-image: linear-gradient(
        to right,
        transparent 0,
        rgb(0 0 0 / 0.007) 0.82%,
        rgb(0 0 0 / 0.045) 1.64%,
        rgb(0 0 0 / 0.129) 2.45%,
        rgb(0 0 0 / 0.257) 3.27%,
        rgb(0 0 0 / 0.415) 4.09%,
        rgb(0 0 0 / 0.585) 4.91%,
        rgb(0 0 0 / 0.743) 5.73%,
        rgb(0 0 0 / 0.871) 6.55%,
        rgb(0 0 0 / 0.955) 7.36%,
        rgb(0 0 0 / 0.993) 8.18%,
        #000 9%
      );
      mask-image: linear-gradient(
        to right,
        transparent 0,
        rgb(0 0 0 / 0.007) 0.82%,
        rgb(0 0 0 / 0.045) 1.64%,
        rgb(0 0 0 / 0.129) 2.45%,
        rgb(0 0 0 / 0.257) 3.27%,
        rgb(0 0 0 / 0.415) 4.09%,
        rgb(0 0 0 / 0.585) 4.91%,
        rgb(0 0 0 / 0.743) 5.73%,
        rgb(0 0 0 / 0.871) 6.55%,
        rgb(0 0 0 / 0.955) 7.36%,
        rgb(0 0 0 / 0.993) 8.18%,
        #000 9%
      );
    }
    /* Reserve the photo column plus a gutter. The page container is wider than
       the viewport in this band, so `%` here resolves against the viewport. */
    .wrap {
      padding-right: calc(46% + 1.5rem);
    }
    /* The vw term is set so the lede actually moves across this band: at 2.2vw
       it sat on the 1.375rem floor the whole way and left the wide end of the
       column half empty. 2.9vw puts it just off the floor at 768 and on the
       1.75rem ceiling by 1023, which is also a clean hand-off to band B's 3vw.
       The measure is in ch, so the line count does not move with it. */
    .lede {
      font-size: clamp(1.375rem, 2.9vw, 1.75rem);
      max-width: 27ch;
      line-height: calc(1.12em + 6px); /* plate height + a 6px gap */
      letter-spacing: var(--text-lede--letter-spacing);
    }
    .hero-blocks {
      font-size: 0.875rem;
      max-width: none;
      margin-top: 1.75rem;
    }
  }

  /* ── Bands A + B — the overlap composition (>= 1024px) ───────────────── */
  @media (min-width: 64rem) {
    .hero {
      display: flex;
      align-items: center;
      min-height: 44rem;
    }
    .wrap {
      width: 100%;
    }
    .media {
      position: absolute;
      inset: 0 0 0 auto;
      width: 69%;
    }
    .media::after {
      display: none;
    }
    .media :global(img),
    .media :global(video) {
      aspect-ratio: auto;
      max-height: none;
      /* His face sits at 41% across and 51% down the landscape crop. */
      object-position: 41% 51%;
      -webkit-mask-image: linear-gradient(
        to right,
        transparent 0,
        rgb(0 0 0 / 0.48) 6%,
        rgb(0 0 0 / 0.483) 7.3%,
        rgb(0 0 0 / 0.498) 8.7%,
        rgb(0 0 0 / 0.534) 10.0%,
        rgb(0 0 0 / 0.589) 11.3%,
        rgb(0 0 0 / 0.660) 12.7%,
        rgb(0 0 0 / 0.740) 14.0%,
        rgb(0 0 0 / 0.820) 15.3%,
        rgb(0 0 0 / 0.891) 16.7%,
        rgb(0 0 0 / 0.946) 18.0%,
        rgb(0 0 0 / 0.982) 19.3%,
        rgb(0 0 0 / 0.997) 20.7%,
        rgb(0 0 0 / 1.000) 22.0%,
        #000 22%
      );
      mask-image: linear-gradient(
        to right,
        transparent 0,
        rgb(0 0 0 / 0.48) 6%,
        rgb(0 0 0 / 0.483) 7.3%,
        rgb(0 0 0 / 0.498) 8.7%,
        rgb(0 0 0 / 0.534) 10.0%,
        rgb(0 0 0 / 0.589) 11.3%,
        rgb(0 0 0 / 0.660) 12.7%,
        rgb(0 0 0 / 0.740) 14.0%,
        rgb(0 0 0 / 0.820) 15.3%,
        rgb(0 0 0 / 0.891) 16.7%,
        rgb(0 0 0 / 0.946) 18.0%,
        rgb(0 0 0 / 0.982) 19.3%,
        rgb(0 0 0 / 0.997) 20.7%,
        rgb(0 0 0 / 1.000) 22.0%,
        #000 22%
      );
    }
    .veil {
      display: block;
      position: absolute;
      inset: 0;
      z-index: 1;
      background: linear-gradient(
        to right,
        color-mix(in srgb, var(--color-ground) 95.0%, transparent) 0,
        color-mix(in srgb, var(--color-ground) 94.2%, transparent) 6.2%,
        color-mix(in srgb, var(--color-ground) 89.5%, transparent) 12.4%,
        color-mix(in srgb, var(--color-ground) 79.5%, transparent) 18.6%,
        color-mix(in srgb, var(--color-ground) 64.8%, transparent) 24.8%,
        color-mix(in srgb, var(--color-ground) 47.5%, transparent) 31.0%,
        color-mix(in srgb, var(--color-ground) 30.2%, transparent) 37.2%,
        color-mix(in srgb, var(--color-ground) 15.5%, transparent) 43.4%,
        color-mix(in srgb, var(--color-ground) 5.5%, transparent) 49.6%,
        color-mix(in srgb, var(--color-ground) 0.8%, transparent) 55.8%,
        color-mix(in srgb, var(--color-ground) 0.0%, transparent) 62.0%
      );
      -webkit-mask-image: linear-gradient(to bottom, transparent 48%, #000 68%);
      mask-image: linear-gradient(to bottom, transparent 48%, #000 68%);
    }
    .lede {
      max-width: 33ch; /* four lines - see the note above */
      font-size: var(--text-lede);
      line-height: calc(1.12em + 6px); /* plate height + a 6px gap */
      letter-spacing: var(--text-lede--letter-spacing);
      font-weight: 500;
      margin-top: 0;
    }
    .hero-blocks {
      font-size: 0.9375rem;
      max-width: 46ch;
      margin-top: 1.75rem;
    }
  }

  /* ── Band B only — 1024-1279px ───────────────────────────────────────────
     Band A's fixed 44rem was the bug: below 1440 it left the photo box a
     different shape from the asset, so object-cover re-cropped the frame Dom
     tuned. Three changes, none of which touch band A:

     1. The height is derived from the photo's own aspect (69vw wide, 3012:2133),
        which lands on 44rem at 1440 and shrinks with the viewport. It is a
        MINIMUM, so long copy still grows the hero.
     2. The photo is anchored to its own LEFT edge. Whenever the box is
        narrower than the asset's aspect the scale is height-driven, so
        anchoring left means the dissolve zone shows exactly the sky, palms and
        lamp it shows at 1440, and everything over-wide is clipped off the
        right instead. At 1440 the box matches the asset, so this is a no-op —
        which is why band A can keep 41% without differing.
     3. The copy column is tied to the viewport as well as the measure, so its
        tail keeps roughly the same relation to the dissolve as at 1440 (where
        the blocks reach 8.5% into the photo). The body steps down one notch to
        0.875rem, which also shortens the hero. */
  @media (min-width: 64rem) and (max-width: 79.9375rem) {
    .hero {
      min-height: calc(69vw * 2133 / 3012);
    }
    .media :global(img),
    .media :global(video) {
      object-position: left 51%;
    }
    .hero-blocks {
      font-size: 0.875rem;
      max-width: min(46ch, 34vw);
    }
    /* The tools line is the one piece of copy with a FIXED pixel length, so as
       the viewport narrows its tail reaches proportionally further into the
       photo than anything else — at 1024 it landed on the dark palms and
       measured 3.75:1 against ink. Capping it to the copy column wraps it onto
       a second line (as band C already does) and brings it back to the same
       relation to the dissolve it has at 1440. Band A keeps it running long. */
    .hero-tools {
      max-width: min(46ch, 34vw);
    }
  }

  /* Plate: each line of the lede carries its own solid block, the way a
     highlighter would. Two things make it work:
     - `box-decoration-break: clone` repeats the padding and background per
       line instead of wrapping the whole run once.
     - the block is a GRADIENT BAND, not the element's background. An inline
       background paints the full font box, which for Hanken is 1.303em - taller
       than the text and with no way to shrink it, so consecutive plates touch.
       Painting a band at 86% of that box makes the plate shorter than the line,
       which is the only way to get real gaps between the lines (Dom, 2026-09-07).
     Plate height is therefore 1.303em x 0.86 = 1.12em, and the line-height is
     that plus the gap. Change one, change the other.
     The negative margin pulls the first character back onto the text column's
     left edge so the plate's padding does not read as an indent. */
  .lede span {
    color: var(--color-ink);
    background-image: linear-gradient(var(--color-plate), var(--color-plate));
    background-repeat: no-repeat;
    background-position: left center;
    background-size: 100% 86%;
    box-decoration-break: clone;
    -webkit-box-decoration-break: clone;
    padding: 0 10px;
    margin-left: -10px;
  }
</style>
