---
import site from "../data/site.json";
interface Props {
  heading?: string;
  description?: string;
}
const {
  heading = "Have a product in mind?",
  description = "Send me your brief and I’ll suggest a few story ideas. Start with a three-video pilot, or book a free 15-minute call to talk it through.",
} = Astro.props;
---

<section id="book-call" class="hero" aria-labelledby="hero-heading">
  <div class="hero-copy">
    <div class="hero-copy-inner">
      <h2 id="hero-heading"><span>{heading}</span></h2>
      <p class="hero-support">{description}</p>
      <a class="book-button" href={site.bookingUrl} target="_blank" rel="noopener noreferrer">Book a 15-minute call <span aria-hidden="true">↗</span></a>
      <p class="call-note">Prefer email? Send your brief to <a href={`mailto:${site.email}`}>{site.email}</a>.</p>
    </div>
  </div>
  <div class="hero-portrait">
  <picture class="hero-media">
    <img src="/work-with-me.webp" alt="Dom overlooking the city at sunset" width="1000" height="1334" loading="lazy" decoding="async" />
  </picture>
  </div>
</section>

<style>
  .hero { display: grid; grid-template-columns: 1.15fr 1fr; min-height: clamp(540px, 55vw, 790px); }
  .hero-copy { min-width: 0; padding: 56px 9%; display: flex; flex-direction: column; align-items: flex-start; justify-content: center; }
  .hero-copy-inner { width: fit-content; max-width: 100%; align-self: center; }
  h2 { position: relative; z-index: 2; width: 100%; margin: 0 0 24px; font-size: var(--text-section); font-weight: 600; line-height: var(--text-section--line-height); letter-spacing: var(--text-section--letter-spacing); }
  h2 > span { display: inline; background: var(--color-plate); padding: 0 .16em; -webkit-box-decoration-break: clone; box-decoration-break: clone; }
  .hero-support { margin: 0; max-width: 44ch; font-size: var(--text-body); line-height: 1.5; white-space: pre-line; }
  .hero{scroll-margin-top:80px}
  .book-button{display:inline-flex;align-items:center;gap:24px;margin-top:24px;padding:16px 20px;background:var(--color-accent);color:var(--color-accent-ink);font-weight:600;border:1px solid var(--color-accent)}
  .book-button:hover{background:var(--color-ink);color:var(--color-ground)}
  .call-note{font-size:var(--text-caption);line-height:1.5;color:var(--color-ink-dim);max-width:38ch;margin:12px 0 0}
  .call-note a{text-decoration:underline;text-underline-offset:3px;overflow-wrap:anywhere}
  .hero-portrait { position: relative; min-width: 0; width: 82%; max-width: 560px; align-self: center; justify-self: center; padding-block: 32px; translate: 0 16px; }
  .hero-media { position: relative; display: block; min-width: 0; width: 100%; aspect-ratio: 1; }
  .hero-media img { position: absolute; inset: 0; display: block; width: 100%; height: 100%; object-fit: cover; object-position: 50% 60%; }
  @media (max-width: 650px) {
    .hero { grid-template-columns: 1fr; min-height: 0; }
    .hero-copy { padding: 36px 6%; }
    .hero-copy-inner { width: 100%; }
    h2 { width: 100%; font-size: var(--text-section); margin-bottom: 24px; }
    .hero-support { font-size:var(--text-body); }
    .hero-portrait { width: 88%; max-width: 440px; padding-block: 0; margin-bottom: 36px; translate: none; }
    .hero-media img { object-position: 50% 60%; }
  }
</style>
