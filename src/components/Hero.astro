---
import site from "../data/site.json";
const { hero } = site;
const base = hero.poster.replace(/\.jpg$/, "");
---

<section class="hero" aria-labelledby="hero-heading">
  <div class="hero-stage">
    <picture class="hero-media">
      <source type="image/webp" srcset={`${base}-1000.webp 1000w, ${base}.webp 2000w`} sizes="(max-width: 650px) 100vw, 68vw" />
      <img src={hero.poster} srcset={`${base}-1000.jpg 1000w, ${base}.jpg 2000w`} sizes="(max-width: 650px) 100vw, 68vw" alt={hero.posterAlt} width="2000" height="1416" fetchpriority="high" decoding="async" />
    </picture>
    <div class="hero-wash" aria-hidden="true"></div>
    <div class="hero-copy">
      <h1 id="hero-heading"><span>{hero.headline[0]}</span><span>{hero.headline[1]}</span><span><span class="hero-plate">{hero.headline[2]}</span></span></h1>
      <p class="hero-support">{hero.support}</p>
      <a class="hero-work" href="#work">View selected work <span aria-hidden="true">↓</span></a>
    </div>
  </div>
</section>

<style>
  .hero { container-type: inline-size; }
  .hero-stage { position: relative; isolation: isolate; min-height: 540px; height: 54cqw; max-height: 960px; overflow: hidden; }
  .hero-media { position: absolute; inset: 0 0 0 auto; width: 68%; z-index: -2; mask-image: linear-gradient(90deg, transparent, #000 16%); }
  .hero-media img { display: block; width: 100%; height: 100%; object-fit: cover; object-position: 42% center; }
  .hero-wash { position: absolute; inset: 0; z-index: -1; background: linear-gradient(90deg, var(--color-ground) 0%, var(--color-ground) 24%, color-mix(in srgb, var(--color-ground) 73%, transparent) 40%, transparent 66%); }
  .hero-copy { width: 66%; height: 100%; padding: 48px 5%; display: flex; flex-direction: column; align-items: flex-start; justify-content: center; }
  h1 { margin: 0 0 30px; font-size: clamp(35px, 6cqw, 120px); font-weight: 600; line-height: .98; letter-spacing: -.055em; }
  h1 > span { display: block; }
  .hero-plate { background: var(--color-plate); padding: 0 .07em; box-decoration-break: clone; -webkit-box-decoration-break: clone; white-space: nowrap; }
  .hero-support { margin: 0; font-size: clamp(16px, 1.35cqw, 24px); line-height: 1.5; }
  .hero-work { display: inline-flex; align-items: center; gap: .3em; min-height: 44px; width: fit-content; margin-top: 28px; padding: 8px 0; border-bottom: 1px solid var(--color-ink); font-size: clamp(14px, 1.2cqw, 20px); font-weight: 600; }
  .hero-work:hover { text-decoration: underline; text-underline-offset: 4px; }
  @media (max-width: 650px) {
    .hero-stage { height: auto; min-height: 0; max-height: none; }
    .hero-media { inset: 0 0 auto; width: 100%; height: 300px; mask-image: none; }
    .hero-media img { object-position: 42% 38%; }
    .hero-wash { background: linear-gradient(180deg, transparent 0px, transparent 175px, var(--color-ground) 300px); }
    .hero-copy { padding: 240px 6% 32px; width: 100%; height: auto; }
    h1 { font-size: 11.7cqw; margin-bottom: 18px; }
    .hero-support { font-size: 14px; }
    .hero-work { margin-top: 12px; font-size: 14px; }
  }
</style>
