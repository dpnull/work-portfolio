---
import site from "../data/site.json";
import HeroMedia from "./HeroMedia.astro";
const { hero } = site;
---

<section
  aria-labelledby="hero-heading"
  class="mx-auto grid max-w-(--container-page) items-center gap-8 px-6 py-10 sm:px-8 lg:grid-cols-12 lg:gap-12 lg:py-16"
>
  <!-- Copy first in the DOM so the phone shows the promise before the media. -->
  <div class="lg:order-2 lg:col-span-7">
    <p class="text-paper-dim font-mono text-xs tracking-widest uppercase">{hero.eyebrow}</p>
    <h1 id="hero-heading" class="font-display text-hero mt-5 text-balance">{hero.promise}</h1>
    <p class="text-paper-dim mt-6 max-w-lg text-lg text-pretty">{hero.positioning}</p>
    <a
      href={`mailto:${site.email}`}
      class="text-paper mt-8 inline-block font-mono text-sm underline decoration-(--color-line) underline-offset-4 hover:decoration-(--color-accent)"
    >
      {site.email}
    </a>
  </div>

  <!-- Square frame: capping the width caps the height too, so the stats stay in reach on phones. -->
  <div class="mx-auto w-full max-w-[min(100%,60svh)] lg:order-1 lg:col-span-5 lg:max-w-none">
    <HeroMedia poster={hero.poster} alt={hero.posterAlt} video={hero.video} />
  </div>
</section>
