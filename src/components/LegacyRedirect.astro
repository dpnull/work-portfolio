---
interface Props { destination: string }
const { destination } = Astro.props;
---
<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <link rel="canonical" href={new URL(destination, Astro.site)} />
    <title>Page moved — Dom Przewozny</title>
    <script is:inline define:vars={{ destination }}>
      location.replace(destination + location.search + location.hash);
    </script>
  </head>
  <body><p>This page has moved. <a href={destination}>Continue to the portfolio</a>.</p></body>
</html>
