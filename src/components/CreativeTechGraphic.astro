---
import audience from '../assets/creative-tech/01-audience-funnel.svg?raw';
import production from '../assets/creative-tech/02-creator-production.svg?raw';
import portfolio from '../assets/creative-tech/03-portfolio-system.svg?raw';

interface Props { kind: 'audience' | 'production' | 'portfolio' }
const graphics = {
  audience: {
    art: audience,
    title: 'What happens after someone watches?',
    subtitle: 'A video starts the conversation. A useful next step helps me learn what the viewer needs and keep in touch.',
    viewBox: '64 195 1016 256',
    description: 'Define your ideal audience. Create content to attract them. Use a funnel to learn more about them. Collect email addresses, locations, needs and gaps.',
    panels: [
      ['18 185 264 275', 'Define your ideal audience.'],
      ['292 185 264 275', 'Create content to attract them.'],
      ['564 185 264 275', 'Use a funnel to learn more about them. This example uses a 28-question assessment.'],
      ['838 185 264 275', 'Collect email addresses and audience insights: location, needs and gaps.'],
    ],
    caption: '',
  },
  production: {
    art: production,
    title: 'From audience insight to the next month of content.',
    subtitle: 'Research what your audience cares about, plan the stories, film and edit them, then review what worked to shape the next month.',
    viewBox: '64 223 1016 256',
    description: 'Research: topics and scripts. Plan: people and logistics. Film: camera. Edit: story and colour. Review: results and next steps.',
    panels: [
      ['20 211 264 275', 'Research: topics and scripts.'],
      ['224 211 264 275', 'Plan: people and logistics.'],
      ['428 211 264 275', 'Film: camera.'],
      ['632 211 264 275', 'Edit: story and colour.'],
      ['836 211 264 275', 'Review: results and next steps.'],
    ],
    caption: '',
  },
  portfolio: {
    art: portfolio,
    title: 'Two disciplines. One connected home.',
    subtitle: 'A shared design, with space for both sides of my work.',
    viewBox: '0 150 1120 395',
    description: 'work.dpy2k.com connects Brand ads with Content systems. Self-hosted video sits alongside audience funnels, creator production and this portfolio.',
    panels: [
      ['115 272 360 265', 'Brand ads: self-hosted video.'],
      ['645 272 360 265', 'Content systems: audience funnel, creator production and this portfolio.'],
    ],
    caption: '',
  },
};
const { kind } = Astro.props;
const graphic = graphics[kind];
// These are local, reviewed SVG sources; retain native text and shared site tokens.
const drawing = graphic.art.replace(/^<svg\b[^>]*>/, '').replace(/<\/svg>\s*$/, '');
// Isolate each production stage in compact views so neighboring labels do not enter the crop.
const panelDrawing = (index: number) => kind === 'production'
  ? drawing.replace(/<g data-production-stage="(\d+)"[^>]*>[\s\S]*?<\/g>/g, (group, stage) => Number(stage) === index ? group : '')
  : drawing;
---
<div class:list={['work-graphic', kind]}>
  <header>
    <h2>{graphic.title}</h2>
    <p>{graphic.subtitle}</p>
  </header>
  <svg class="wide-art" viewBox={graphic.viewBox} role="img" aria-label={graphic.description}>
    <g aria-hidden="true" set:html={drawing} />
  </svg>
  <div class="compact-art">
    {kind === 'portfolio' && <p class="site-root">work.dpy2k.com</p>}
    <div class="panels">
      {graphic.panels.map(([viewBox, label], index) => (
        <svg viewBox={viewBox} role="img" aria-label={label}>
          <g aria-hidden="true" set:html={panelDrawing(index)} />
        </svg>
      ))}
    </div>
    {graphic.caption && <p class="feedback">↳ {graphic.caption}</p>}
  </div>
</div>
<style>
  header{margin-bottom:24px}
  h2{font-size:var(--text-section);font-weight:500;letter-spacing:-.025em;line-height:1.15;margin:0 0 14px}
  header p{font-size:var(--text-body);line-height:1.5;color:var(--color-ink-dim);margin:0;max-width:62ch}
  /* Crop the source-art margins; both diagrams share the same canvas and scale. */
  .wide-art{width:min(100%,var(--graphic-stage-width));max-width:var(--graphic-stage-width);margin:0;padding:0}
  svg{display:block;width:100%;height:auto;font-family:var(--font-sans);overflow:hidden}
  .compact-art{display:none}
  @media(max-width:700px){
    header{padding:0;margin-bottom:24px}
    .wide-art{display:none}
    .compact-art{display:block}
    .panels{display:grid;grid-template-columns:repeat(2,minmax(0,var(--graphic-panel-width)));gap:24px 8px}
    .compact-art :global(.connector){display:none}
    .feedback{font-size:var(--text-caption);line-height:1.5;color:var(--color-ink-dim);margin:20px 0 0}
    .site-root{font-size:var(--text-body);font-weight:500;text-align:center;margin:0 0 20px}
    .portfolio .panels{grid-template-columns:1fr;max-width:420px;margin:auto;gap:20px}
  }
</style>
