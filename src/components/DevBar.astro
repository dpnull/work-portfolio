---
/**
 * DEV BAR — Dom's own control surface. NOT SHIPPED.
 *
 * Rendered only when `import.meta.env.DEV` is true, so it exists on
 * `npm run dev` and is absent from `npm run build` output entirely — no flag to
 * remember, no class to strip before launch.
 *
 * Right-hand rail, one hairline down its left edge, groups stacked from the
 * top. Group one is the stats strip colour; add the next control as another
 * `<section class="g">` and nothing else has to move.
 *
 * The palette is a HUE RAMP, not a free colour picker, and that is the whole
 * point of it. Every colour on it is oklch(0.79 0.116 h) — the lightness and
 * chroma the strip was designed around (see the --color-strip note in
 * global.css: the chroma cap is what keeps the lime CTA the loudest object on
 * the page, and the lightness is what holds the ink at 9:1). Hue is the only
 * free variable, so anything picked off the ramp is accessible by construction.
 * A free RGB picker would let a bad pick through on the first click.
 *
 * What it changes is `--color-strip` on <html>, i.e. the same one token the
 * real site reads. Picking here shows the true result, and the hex shown is the
 * value to paste into global.css to make it permanent. Clicking the hex copies
 * it. The choice is remembered in localStorage so a reload keeps it, and the
 * live token value is only overridden once something has actually been picked.
 */
const DEV = import.meta.env.DEV;

// The five from the strip picker (agent, 2026-09-08). Hue only — see above.
const SWATCHES = [
  { name: "Periwinkle", h: 302 },
  { name: "Sky", h: 247 },
  { name: "Aqua", h: 187 },
  { name: "Apricot", h: 62 },
  { name: "Rose", h: 15 },
];
// Ramp stops every 24°: fine enough that the band reads continuous, coarse
// enough that the gradient is not a 360-stop wall of CSS.
const STOPS = Array.from({ length: 16 }, (_, i) => i * 24);

const CSS = `
/* Every selector is under #devbar: this sheet is \`is:inline\`, so Astro does not
   scope it, and bare \`.tab\` / \`.row\` / \`.hex\` would reach into the site. */
#devbar {
  position: fixed; top: 0; right: 0; z-index: 9999;
  height: 100vh; width: 232px; padding: 14px;
  background: rgb(255 255 255 / 0.72);
  backdrop-filter: blur(12px);
  border-left: 1px solid rgb(25 19 32 / 0.16);
  transition: transform 0.18s ease;
  font-family: var(--font-mono, ui-monospace, monospace);
}
#devbar[data-open="0"] { transform: translateX(232px); }

/* Handle rides on the bar's outer edge so it stays reachable when closed. */
#devbar .tab {
  position: absolute; top: 50%; left: -13px;
  width: 13px; height: 56px; margin-top: -28px; padding: 0;
  border: 1px solid rgb(25 19 32 / 0.16); border-right: 0;
  background: rgb(255 255 255 / 0.72);
  backdrop-filter: blur(12px);
  cursor: pointer;
}

#devbar .g { display: flex; flex-direction: column; gap: 8px; }
/* Groups added later separate themselves; no headings, by Dom's call. */
#devbar .g + .g {
  margin-top: 14px; padding-top: 14px;
  border-top: 1px solid rgb(25 19 32 / 0.16);
}

#devbar .row { display: grid; grid-template-columns: repeat(5, 1fr); gap: 6px; }
#devbar .sw {
  height: 26px; padding: 0;
  border: 1px solid rgb(25 19 32 / 0.16);
  cursor: pointer;
}

#devbar .ramp {
  position: relative; height: 34px;
  border: 1px solid rgb(25 19 32 / 0.16);
  cursor: crosshair; touch-action: none;
}
#devbar .pin {
  position: absolute; top: -2px; bottom: -2px;
  width: 2px; margin-left: -1px;
  background: #191320;
  box-shadow: 0 0 0 1px rgb(255 255 255 / 0.9);
  pointer-events: none;
}

#devbar .hex {
  display: flex; align-items: center; gap: 7px;
  padding: 5px 7px;
  border: 1px solid rgb(25 19 32 / 0.16);
  background: none;
  font: inherit; font-size: 11px; letter-spacing: 0.02em;
  color: #191320; text-align: left;
  cursor: copy;
}
#devbar .hex::before {
  content: ""; width: 11px; height: 11px;
  background: var(--c);
  outline: 1px solid rgb(25 19 32 / 0.16);
}
#devbar .hex[data-copied]::after { content: "copied"; opacity: 0.5; }
`;
---

{
  DEV && (
    <aside id="devbar" class="devbar" data-open="1" aria-label="Dev controls">
      <button id="devbar-toggle" class="tab" type="button" aria-label="Toggle dev bar" />

      <div class="body">
        <section class="g">
          <div class="row">
            {SWATCHES.map((s) => (
              <button
                type="button"
                class="sw"
                data-h={s.h}
                title={s.name}
                style={`background: oklch(0.79 0.116 ${s.h})`}
              />
            ))}
          </div>

          <div
            id="ramp"
            class="ramp"
            style={`background: linear-gradient(90deg, ${STOPS.map(
              (h, i) => `oklch(0.79 0.116 ${h}) ${(i / (STOPS.length - 1)) * 100}%`,
            ).join(", ")})`}
          >
            <span id="ramp-pin" class="pin" />
          </div>

          <button id="hex" class="hex" type="button" />
        </section>
      </div>
    </aside>
  )
}

{
  DEV && (
    <script is:inline>
      (() => {
        const KEY = "devbar:strip-hue";
        const L = 0.79;
        const C0 = 0.116;
        const bar = document.getElementById("devbar");
        const ramp = document.getElementById("ramp");
        const pin = document.getElementById("ramp-pin");
        const hexBtn = document.getElementById("hex");
        const root = document.documentElement;

        /* oklch -> sRGB hex. Needed because the token has to be pasted into
           global.css as a hex, and because a hue that leaves the sRGB gamut at
           this chroma must be caught rather than silently clipped: `fit` walks
           the chroma down until the colour is representable, so the swatch and
           the strip always agree with the hex shown. */
        const toRgb = (l, c, hDeg) => {
          const h = (hDeg * Math.PI) / 180;
          const a = c * Math.cos(h);
          const b = c * Math.sin(h);
          const l_ = (l + 0.3963377774 * a + 0.2158037573 * b) ** 3;
          const m_ = (l - 0.1055613458 * a - 0.0638541728 * b) ** 3;
          const s_ = (l - 0.0894841775 * a - 1.291485548 * b) ** 3;
          return [
            4.0767416621 * l_ - 3.3077115913 * m_ + 0.2309699292 * s_,
            -1.2684380046 * l_ + 2.6097574011 * m_ - 0.3413193965 * s_,
            -0.0041960863 * l_ - 0.7034186147 * m_ + 1.707614701 * s_,
          ];
        };
        const gamma = (v) =>
          v <= 0.0031308 ? 12.92 * v : 1.055 * Math.pow(v, 1 / 2.4) - 0.055;
        const inGamut = (rgb) => rgb.every((v) => v >= -0.0001 && v <= 1.0001);
        const fit = (hDeg) => {
          let c = C0;
          while (c > 0 && !inGamut(toRgb(L, c, hDeg))) c -= 0.002;
          return toRgb(L, c, hDeg);
        };
        const hex = (hDeg) =>
          "#" +
          fit(hDeg)
            .map((v) =>
              Math.round(Math.min(1, Math.max(0, gamma(v))) * 255)
                .toString(16)
                .padStart(2, "0"),
            )
            .join("");

        const apply = (h, persist) => {
          const value = hex(h);
          root.style.setProperty("--color-strip", value);
          pin.style.left = (h / 360) * 100 + "%";
          pin.style.opacity = "1"; // hidden until the first pick — see init
          hexBtn.textContent = value;
          hexBtn.style.setProperty("--c", value);
          if (persist) localStorage.setItem(KEY, String(h));
        };

        const hueAt = (event) => {
          const r = ramp.getBoundingClientRect();
          const x = Math.min(r.width, Math.max(0, event.clientX - r.left));
          return Math.round((x / r.width) * 360);
        };

        // Drag across the ramp, not just click: finding the hue you want is a
        // scrub, and a click-only ramp makes that sixty separate decisions.
        let dragging = false;
        ramp.addEventListener("pointerdown", (e) => {
          dragging = true;
          ramp.setPointerCapture(e.pointerId);
          apply(hueAt(e), true);
        });
        ramp.addEventListener("pointermove", (e) => dragging && apply(hueAt(e), true));
        ramp.addEventListener("pointerup", () => (dragging = false));

        bar.querySelectorAll(".sw").forEach((sw) =>
          sw.addEventListener("click", () => apply(Number(sw.dataset.h), true)),
        );

        hexBtn.addEventListener("click", () => {
          navigator.clipboard?.writeText(hexBtn.textContent || "");
          hexBtn.dataset.copied = "1";
          setTimeout(() => delete hexBtn.dataset.copied, 700);
        });

        document.getElementById("devbar-toggle").addEventListener("click", () => {
          bar.dataset.open = bar.dataset.open === "1" ? "0" : "1";
          localStorage.setItem("devbar:open", bar.dataset.open);
        });
        /* Starts CLOSED on a narrow viewport. The rail is a fixed 232px, which
           is 62% of a 375px screen — open by default it hides the very layout
           you narrowed the window to look at. An explicit choice still wins at
           any width; this only decides the default. */
        const openPref = localStorage.getItem("devbar:open");
        const autoOpen = () => {
          if (openPref !== null) return; // an explicit choice wins at any width
          bar.dataset.open = innerWidth < 900 ? "0" : "1";
        };
        if (openPref === "0") bar.dataset.open = "0";
        autoOpen();
        // Re-evaluated on resize, not just at load: dragging the window narrow
        // to check a breakpoint is exactly when the rail is in the way, and a
        // load-time-only check leaves it open over the layout being inspected.
        addEventListener("resize", autoOpen);

        // Only override the real token once a pick has been made — with nothing
        // stored, the page must show what global.css actually says.
        const saved = localStorage.getItem(KEY);
        if (saved !== null) apply(Number(saved), false);
        else {
          const live = getComputedStyle(root).getPropertyValue("--color-strip").trim();
          hexBtn.textContent = live;
          hexBtn.style.setProperty("--c", live);
          pin.style.opacity = "0";
        }
      })();
    </script>
  )
}

{
  /* INLINE, and inside the DEV guard, on purpose. A plain <style> block is
     emitted into the production CSS bundle whenever the component is imported —
     even though the markup above never renders — which put ~1KB of dead dev-bar
     rules in the shipped stylesheet. `is:inline` + `set:html` ties the sheet to
     the same condition as the markup, so the build is clean. Verified: `.devbar`
     appears nowhere in dist/ after a build. */
  DEV && <style is:inline set:html={CSS} />
}
